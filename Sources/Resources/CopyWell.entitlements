<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- StoreKit purchases and App Store receipt validation. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Files the user hands us explicitly (Services, drag and drop, save panels). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- The presenter's camera bubble and voice in screen recordings. Each is
         off until the user switches it on, and only then is the system asked. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Screen recordings are saved to Movies ▸ CopyWell. -->
    <key>com.apple.security.assets.movies.read-write</key>
    <true/>

    <!-- Private CloudKit database for optional history sync. -->
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    </array>

    <!-- Keychain group holding the key that encrypts sensitive clips. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    </array>
</dict>
</plist>
