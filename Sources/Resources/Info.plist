<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleName</key>
    <string>CopyWell</string>
    <key>CFBundleDisplayName</key>
    <string>CopyWell</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 CopyWell. All rights reserved.</string>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- The clipboard history requests no privacy-protected data. It does
         not synthesise keystrokes, so it needs no Accessibility access; clips
         are placed on the pasteboard and the user presses ⌘V, or inserts them
         through the Services entries below.

         Screenshots and screen recordings use ScreenCaptureKit, which needs
         the Screen Recording permission. macOS has no usage-description key
         for it; CopyWell explains it in its own alert the first time either
         feature is used.

         The camera and microphone are used only for the presenter's bubble
         and voice in screen recordings, both off by default and asked for
         when switched on. Translations live in InfoPlist.xcstrings. -->
    <key>NSCameraUsageDescription</key>
    <string>CopyWell shows your camera in a round bubble over screen recordings, when you switch the camera on.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>CopyWell records your voice with screen recordings, when you switch the microphone on.</string>

    <!-- The Finder extension runs in its own sandbox and cannot reach the app's
         database, so it hands the selection over through this scheme. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.copywell.app</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>copywell</string>
            </array>
        </dict>
    </array>

    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Save to CopyWell</string>
            </dict>
            <key>NSMessage</key>
            <string>saveSelectionToCopyWell</string>
            <key>NSPortName</key>
            <string>CopyWell</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
                <string>public.rtf</string>
                <string>public.png</string>
                <string>public.tiff</string>
                <string>public.file-url</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Pin to CopyWell</string>
            </dict>
            <key>NSMessage</key>
            <string>pinToCopyWell</string>
            <key>NSPortName</key>
            <string>CopyWell</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
                <string>public.rtf</string>
                <string>public.png</string>
                <string>public.tiff</string>
                <string>public.file-url</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Add to CopyWell Paste Stack</string>
            </dict>
            <key>NSMessage</key>
            <string>addToPasteStack</string>
            <key>NSPortName</key>
            <string>CopyWell</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
                <string>public.rtf</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Copy Text in Image</string>
            </dict>
            <key>NSMessage</key>
            <string>recognizeTextFromCopyWell</string>
            <key>NSPortName</key>
            <string>CopyWell</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.png</string>
                <string>public.tiff</string>
                <string>public.file-url</string>
            </array>
            <key>NSReturnTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Paste as Plain Text from CopyWell</string>
            </dict>
            <key>NSMessage</key>
            <string>pastePlainFromCopyWell</string>
            <key>NSPortName</key>
            <string>CopyWell</string>
            <key>NSReturnTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Paste from CopyWell</string>
            </dict>
            <key>NSMessage</key>
            <string>quickPasteFromCopyWell</string>
            <key>NSPortName</key>
            <string>CopyWell</string>
            <key>NSReturnTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
