        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ખરીદી મંજૂરીની રાહ જોઈ રહી છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಖರೀದಿ ಅನುಮೋದನೆಗಾಗಿ ಬಾಕಿ ಇದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാങ്ങൽ അംഗീകാരത്തിനായി കാത്തിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची खरेदी मंजुरीच्या प्रतीक्षेत आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ କ୍ରୟ ଅନୁମୋଦନ ପାଇଁ ଅପେକ୍ଷାରେ ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਖਰੀਦ ਮਨਜ਼ੂਰੀ ਦੀ ਉਡੀਕ ਵਿੱਚ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš nakup čaka na odobritev."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வாங்குதல் ஒப்புதலுக்காகக் காத்திருக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ కొనుగోలు ఆమోదం కోసం పెండింగ్‌లో ఉంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی خریداری منظوری کی منتظر ہے۔"
          }
        }
      }
    },
