        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看你最常拷貝什麼，又是從哪些 App 拷來的。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সবচেয়ে বেশি কী কপি করেন এবং কোন অ্যাপ থেকে, তা দেখুন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સૌથી વધુ શું કૉપિ કરો છો અને કઈ ઍપમાંથી, તે જુઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಹೆಚ್ಚಾಗಿ ಏನನ್ನು ಮತ್ತು ಯಾವ ಆ್ಯಪ್‌ಗಳಿಂದ ನಕಲಿಸುತ್ತೀರಿ ಎಂದು ನೋಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഏറ്റവുമധികം എന്ത് പകർത്തുന്നുവെന്നും ഏതൊക്കെ ആപ്പുകളിൽ നിന്നാണെന്നും കാണുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही सर्वाधिक काय आणि कोणत्या ॲप्समधून कॉपी करता ते पाहा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ କ'ଣ ସବୁଠାରୁ ଅଧିକ କପି କରନ୍ତି ଏବଂ କେଉଁ ଆପରୁ, ତାହା ଦେଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੇਖੋ ਕਿ ਤੁਸੀਂ ਸਭ ਤੋਂ ਵੱਧ ਕੀ ਕਾਪੀ ਕਰਦੇ ਹੋ ਅਤੇ ਕਿਹੜੀਆਂ ਐਪਾਂ ਤੋਂ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglejte si, kaj kopirate najpogosteje in iz katerih aplikacij."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அதிகம் நகலெடுப்பது எது, எந்த ஆப்களிலிருந்து என்பதைப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎక్కువగా ఏమి కాపీ చేస్తారో, ఏ యాప్‌ల నుండి కాపీ చేస్తారో చూడండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھیں کہ آپ سب سے زیادہ کیا اور کن ایپس سے کاپی کرتے ہیں۔"
          }
        }
      }
    },
    "See what you copy most, which apps you copy from, and how your history grows over time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على ما تنسخه أكثر، ومن أي التطبيقات، وكيف ينمو سجلك مع الوقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira què copies més, des de quines apps i com creix el teu historial amb el temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, co kopírujete nejčastěji, ze kterých aplikací a jak vaše historie v čase roste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvad du kopierer mest, hvilke programmer det kommer fra, og hvordan din historik vokser med tiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was du am häufigsten kopierst, aus welchen Apps es stammt und wie dein Verlauf wächst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε τι αντιγράφετε περισσότερο, από ποιες εφαρμογές και πώς μεγαλώνει το ιστορικό σας με τον καιρό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you copy most, which apps you copy from, and how your history grows over time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué copias más, desde qué apps y cómo crece tu historial con el tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, mitä kopioit eniten, mistä ohjelmista ja miten historiasi kasvaa ajan myötä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que vous copiez le plus, depuis quelles apps, et comment votre historique évolue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראו מה אתם מעתיקים הכי הרבה, מאילו יישומים, וכיצד ההיסטוריה שלכם גדלה עם הזמן."
