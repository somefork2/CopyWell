        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell आपकी जगह कभी कुंजियाँ नहीं दबाता, इसलिए उसे सुगम्यता की अनुमति नहीं चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nikad ne pritišće tipke umjesto vas, pa mu ne treba pristup Pristupačnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CopyWell soha nem nyom le billentyűket ön helyett, ezért nincs szüksége a Kisegítő lehetőségek engedélyére."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tidak pernah menekan tombol untuk Anda, jadi tidak butuh izin Aksesibilitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non preme mai i tasti al posto tuo, quindi non ha bisogno dell’accesso ad Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellが代わりにキーを押すことはないため、アクセシビリティ権限は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 대신 키를 누르지 않으므로 손쉬운 사용 권한이 필요 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tidak pernah menekan kekunci bagi pihak anda, jadi ia tidak memerlukan akses Kebolehcapaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trykker aldri på taster for deg, og trenger derfor ingen tilgang til Tilgjengelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drukt nooit toetsen voor je in en heeft dus geen toegang tot Toegankelijkheid nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nigdy nie naciska klawiszy za Ciebie, więc nie potrzebuje dostępu do Dostępności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell nunca aperta teclas por você, então não precisa de acesso à Acessibilidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell nunca prime teclas por si, por isso não precisa de acesso à Acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nu apasă niciodată taste în locul dvs., așa că nu are nevoie de acces la Accesibilitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не нажимает клавиши за вас, поэтому доступ к Универсальному доступу не нужен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell za vás nikdy nestláča klávesy, a preto nepotrebuje prístup k Sprístupneniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trycker aldrig på tangenter åt dig och behöver därför ingen tillgång till Tillgänglighet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ไม่เคยกดแป้นแทนคุณ จึงไม่ต้องขอสิทธิ์การช่วยการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sizin yerinize tuşlara basmaz, bu yüzden Erişilebilirlik iznine gerek duymaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не натискає клавіші замість вас, тому доступ до Доступності не потрібен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell không bao giờ bấm phím thay bạn, nên không cần quyền Trợ năng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 从不替你按键，因此无需辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 從不替你按鍵，因此不需要輔助使用權限。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell কখনো আপনার হয়ে কী চাপে না, তাই এর অ্যাক্সেসিবিলিটি অ্যাক্সেসের দরকার নেই।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ક્યારેય તમારા વતી કી દબાવતું નથી, તેથી તેને ઍક્સેસિબિલિટી ઍક્સેસની જરૂર નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ನಿಮ್ಮ ಪರವಾಗಿ ಎಂದಿಗೂ ಕೀಗಳನ್ನು ಒತ್ತುವುದಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದಕ್ಕೆ ಪ್ರವೇಶಿಸುವಿಕೆ ಅನುಮತಿ ಬೇಕಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ഒരിക്കലും നിങ്ങൾക്കുവേണ്ടി കീകൾ അമർത്തുന്നില്ല, അതിനാൽ അതിന് പ്രവേശനക്ഷമത ആക്സസ് ആവശ്യമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell तुमच्यासाठी कधीही कीज दाबत नाही, त्यामुळे त्याला ॲक्सेसिबिलिटी परवानगीची गरज नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ଆପଣଙ୍କ ପାଇଁ କେବେ ବି କି ଦବାଏ ନାହିଁ, ତେଣୁ ଏହାର ଆକ୍ସେସିବିଲିଟି ଅନୁମତିର ଆବଶ୍ୟକତା ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ਕਦੇ ਵੀ ਤੁਹਾਡੇ ਲਈ ਕੁੰਜੀਆਂ ਨਹੀਂ ਦਬਾਉਂਦਾ, ਇਸ ਲਈ ਇਸਨੂੰ ਪਹੁੰਚਯੋਗਤਾ (Accessibility) ਇਜਾਜ਼ਤ ਦੀ ਲੋੜ ਨਹੀਂ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nikoli ne pritiska tipk namesto vas, zato ne potrebuje dovoljenja za dostopnost."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell உங்களுக்காக ஒருபோதும் விசைகளை அழுத்தாது, எனவே அதற்கு அணுகல்தன்மை அனுமதி தேவையில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell మీ తరపున ఎప్పుడూ కీలను నొక్కదు, కాబట్టి దానికి యాక్సెసిబిలిటీ యాక్సెస్ అవసరం లేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell آپ کی جگہ کبھی کلیدیں نہیں دباتا، اس لیے اسے رسائی پذیری کی اجازت درکار نہیں۔"
          }
        }
      }
    },
    "CopyWell never presses keys for you, so it needs no Accessibility access. To insert a clip without pressing ⌘V, use Services ▸ Paste from CopyWell.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يضغط CopyWell المفاتيح نيابة عنك، ولذلك لا يحتاج إلى إذن تسهيلات الاستخدام. لإدراج عنصر دون الضغط على ⌘V، استخدم الخدمات ▸ اللصق من CopyWell."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El CopyWell no prem mai tecles per tu, així que no necessita accés a l’Accessibilitat. Per inserir un element sense prémer ⌘V, fes servir Serveis ▸ Enganxa des del CopyWell."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell za vás nikdy nemačká klávesy, a proto nepotřebuje přístup ke Zpřístupnění. Chcete-li vložit položku bez ⌘V, použijte Služby ▸ Vložit z CopyWellu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell trykker aldrig på taster for dig og har derfor ikke brug for adgang til Tilgængelighed. Vil du indsætte et emne uden ⌘V, så brug Tjenester ▸ Indsæt fra CopyWell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell drückt keine Tasten für dich und braucht deshalb keinen Zugriff auf die Bedienungshilfen. Um einen Eintrag ohne ⌘V einzusetzen, nutze Dienste ▸ Aus CopyWell einfügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το CopyWell δεν πατά ποτέ πλήκτρα για εσάς, γι’ αυτό δεν χρειάζεται πρόσβαση στην Προσβασιμότητα. Για να εισαγάγετε ένα στοιχείο χωρίς ⌘V, χρησιμοποιήστε Υπηρεσίες ▸ Επικόλληση από το CopyWell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell never presses keys for you, so it needs no Accessibility access. To insert a clip without pressing ⌘V, use Services ▸ Paste from CopyWell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nunca pulsa teclas por ti, así que no necesita acceso a Accesibilidad. Para insertar un elemento sin pulsar ⌘V, usa Servicios ▸ Pegar desde CopyWell."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ei koskaan paina näppäimiä puolestasi, joten se ei tarvitse Käyttöapu-oikeutta. Jos haluat lisätä kohteen painamatta ⌘V, käytä Palvelut ▸ Liitä CopyWellista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’appuie jamais sur les touches à votre place : aucun accès à l’Accessibilité n’est nécessaire. Pour insérer un élément sans faire ⌘V, utilisez Services ▸ Coller depuis CopyWell."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell לעולם לא לוחץ על מקשים במקומכם, ולכן אינו זקוק להרשאת נגישות. כדי להכניס פריט בלי ⌘V, השתמשו בשירותים ▸ הדבקה מ-CopyWell."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell आपकी जगह कभी कुंजियाँ नहीं दबाता, इसलिए उसे सुगम्यता की अनुमति नहीं चाहिए। ⌘V दबाए बिना कुछ डालना हो तो सेवाएँ ▸ CopyWell से पेस्ट करें का इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nikad ne pritišće tipke umjesto vas, pa mu ne treba pristup Pristupačnosti. Za umetanje stavke bez ⌘V upotrijebite Usluge ▸ Zalijepi iz CopyWella."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A CopyWell soha nem nyom le billentyűket ön helyett, ezért nincs szüksége a Kisegítő lehetőségek engedélyére. Ha ⌘V nélkül szeretne beszúrni egy elemet, használja a Szolgáltatások ▸ Beillesztés a CopyWellből lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tidak pernah menekan tombol untuk Anda, jadi tidak butuh izin Aksesibilitas. Untuk menyisipkan item tanpa menekan ⌘V, gunakan Layanan ▸ Tempel dari CopyWell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell non preme mai i tasti al posto tuo, quindi non ha bisogno dell’accesso ad Accessibilità. Per inserire un elemento senza premere ⌘V, usa Servizi ▸ Incolla da CopyWell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellが代わりにキーを押すことはないため、アクセシビリティ権限は必要ありません。⌘Vを押さずに項目を挿入するには、サービス ▸ CopyWellからペーストを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell은 대신 키를 누르지 않으므로 손쉬운 사용 권한이 필요 없습니다. ⌘V를 누르지 않고 항목을 넣으려면 서비스 ▸ CopyWell에서 붙여넣기를 사용하세요."
          }
