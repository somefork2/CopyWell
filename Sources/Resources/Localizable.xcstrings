    "Sync history across your Macs through your private iCloud database.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزامن السجل بين أجهزة Mac الخاصة بك عبر قاعدة بيانات iCloud الخاصة بك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronitza l’historial entre els teus Mac mitjançant la teva base de dades privada de l’iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuje historii mezi vašimi Macy přes vaši soukromou databázi na iCloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniserer historikken mellem dine Mac-computere via din egen private iCloud-database."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert den Verlauf zwischen deinen Macs über deine private iCloud-Datenbank."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγχρονίζει το ιστορικό στα Mac σας μέσω της δικής σας ιδιωτικής βάσης δεδομένων iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync history across your Macs through your private iCloud database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza el historial entre tus Mac a través de tu base de datos privada de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronoi historian Maciesi välillä oman yksityisen iCloud-tietokantasi kautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise l’historique entre vos Mac via votre base de données iCloud privée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסנכרן את ההיסטוריה בין מחשבי ה-Mac שלכם דרך מסד הנתונים הפרטי שלכם ב-iCloud."
