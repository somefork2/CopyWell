            "value": "O CopyWell só grava enquanto está em execução. Há mais temas, cores de destaque e tamanhos de texto nos ajustes."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El CopyWell només enregistra mentre s’executa. Hi ha més temes, colors d’accent i mides de text als ajustos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell legt alleen vast zolang het draait. Meer thema’s, accentkleuren en tekstgrootte staan in de instellingen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell spelar bara in medan det körs. Fler teman, accentfärger och textstorlek finns i inställningarna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell optager kun, mens det kører. Flere temaer, accentfarver og tekststørrelse findes i indstillingerne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tar bare opp mens det kjører. Flere temaer, aksentfarger og tekststørrelse finnes i innstillingene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell tallentaa vain ollessaan käynnissä. Lisää teemoja, korostusvärejä ja tekstikokoja löytyy asetuksista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zapisuje tylko wtedy, gdy jest uruchomiony. Więcej motywów, kolorów akcentu i rozmiarów tekstu znajduje się w ustawieniach."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zaznamenává, jen dokud běží. Další motivy, barvy zvýraznění a velikost textu jsou v nastavení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zaznamenáva, len kým beží. Ďalšie motívy, farby zvýraznenia a veľkosť textu sú v nastaveniach."
          }
