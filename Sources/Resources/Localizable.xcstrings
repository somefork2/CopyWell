    "Move with ↑↓ or jump with ⌘1–9. ⌘Y looks at a clip before you take it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنقّل بـ ↑↓ أو انتقل بـ ⌘1–9. ويعرض ⌘Y العنصر قبل أن تأخذه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou-te amb ↑↓ o salta amb ⌘1–9. ⌘Y et mostra un element abans d’agafar-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohybujte se klávesami ↑↓ nebo přeskakujte pomocí ⌘1–9. ⌘Y ukáže položku dřív, než ji vezmete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt med ↑↓, eller hop med ⌘1–9. ⌘Y viser et emne, før du tager det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit ↑↓ bewegen oder mit ⌘1–9 springen. ⌘Y zeigt einen Eintrag an, bevor du ihn nimmst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινηθείτε με ↑↓ ή μεταβείτε με ⌘1–9. Το ⌘Y σας δείχνει ένα στοιχείο πριν το πάρετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move with ↑↓ or jump with ⌘1–9. ⌘Y looks at a clip before you take it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete con ↑↓ o salta con ⌘1–9. ⌘Y te muestra un elemento antes de cogerlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liiku näppäimillä ↑↓ tai hyppää näppäimillä ⌘1–9. ⌘Y näyttää kohteen ennen kuin otat sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez-vous avec ↑↓ ou sautez avec ⌘1–9. ⌘Y montre un élément avant que vous le preniez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נועו עם ↑↓ או קפצו עם ⌘1–9. ⌘Y מציג פריט לפני שלוקחים אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ से चलें या ⌘1–9 से छलाँग लगाएँ। ⌘Y लेने से पहले चीज़ दिखा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krećite se tipkama ↑↓ ili skačite s ⌘1–9. ⌘Y pokazuje stavku prije nego što je uzmete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lépkedjen a ↑↓ gombokkal, vagy ugorjon a ⌘1–9 gombokkal. A ⌘Y megmutatja az elemet, mielőtt elvenné."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpindah dengan ↑↓ atau melompat dengan ⌘1–9. ⌘Y memperlihatkan item sebelum Anda mengambilnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muoviti con ↑↓ o salta con ⌘1–9. ⌘Y ti mostra un elemento prima che tu lo prenda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓で移動、⌘1–9でジャンプ。⌘Yなら取り出す前に中身を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓로 이동하거나 ⌘1–9로 건너뛰세요. ⌘Y로 가져오기 전에 내용을 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergerak dengan ↑↓ atau melompat dengan ⌘1–9. ⌘Y menunjukkan item sebelum anda mengambilnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt med ↑↓ eller hopp med ⌘1–9. ⌘Y viser et objekt før du tar det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg met ↑↓ of spring met ⌘1–9. Met ⌘Y bekijk je een item voordat je het pakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruszaj się klawiszami ↑↓ albo przeskakuj przez ⌘1–9. ⌘Y pokaże wpis, zanim go weźmiesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue com ↑↓ ou pule com ⌘1–9. ⌘Y mostra o item antes de você pegá-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue com ↑↓ ou salte com ⌘1–9. ⌘Y mostra-lhe um item antes de o levar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deplasați-vă cu ↑↓ sau săriți cu ⌘1–9. ⌘Y vă arată un element înainte să îl luați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещайтесь клавишами ↑↓ или переходите через ⌘1–9. ⌘Y покажет запись до того, как вы её возьмёте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohybujte sa klávesmi ↑↓ alebo preskakujte cez ⌘1–9. ⌘Y ukáže položku skôr, než si ju vezmete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta med ↑↓ eller hoppa med ⌘1–9. ⌘Y visar ett objekt innan du tar det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนด้วย ↑↓ หรือข้ามด้วย ⌘1–9 ส่วน ⌘Y ให้คุณดูรายการก่อนหยิบไปใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ ile gezinin ya da ⌘1–9 ile atlayın. ⌘Y, almadan önce öğeye bakmanızı sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переміщуйтеся клавішами ↑↓ або переходьте через ⌘1–9. ⌘Y покаже запис, перш ніж ви його візьмете."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển bằng ↑↓ hoặc nhảy bằng ⌘1–9. ⌘Y cho bạn xem một mục trước khi lấy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ↑↓ 移动，或用 ⌘1–9 跳转。⌘Y 可在取用前先看一眼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ↑↓ 移動，或用 ⌘1–9 跳至。⌘Y 可在取用前先看一眼。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ দিয়ে সরুন বা ⌘1–9 দিয়ে সরাসরি যান। নেওয়ার আগে ⌘Y দিয়ে ক্লিপটি দেখে নিন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ વડે ખસો અથવા ⌘1–9 વડે સીધા જાઓ. ક્લિપ લેતા પહેલાં ⌘Y વડે તેને જોઈ લો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ ಮೂಲಕ ಸರಿಸಿ ಅಥವಾ ⌘1–9 ಮೂಲಕ ನೇರವಾಗಿ ಹೋಗಿ. ಕ್ಲಿಪ್ ತೆಗೆದುಕೊಳ್ಳುವ ಮೊದಲು ⌘Y ಅದನ್ನು ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ ഉപയോഗിച്ച് നീങ്ങുക അല്ലെങ്കിൽ ⌘1–9 ഉപയോഗിച്ച് നേരിട്ട് പോകുക. ഒരു ക്ലിപ്പ് എടുക്കുന്നതിന് മുമ്പ് ⌘Y അത് കാണിച്ചുതരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ ने हला किंवा ⌘1–9 ने थेट जा. क्लिप घेण्यापूर्वी ⌘Y ने ती पाहता येते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ ଦ୍ୱାରା ଘୁଞ୍ଚନ୍ତୁ କିମ୍ବା ⌘1–9 ଦ୍ୱାରା ସିଧା ଯାଆନ୍ତୁ। ନେବା ପୂର୍ବରୁ ⌘Y ଦ୍ୱାରା କ୍ଲିପଟିକୁ ଦେଖନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ ਨਾਲ ਉੱਪਰ-ਹੇਠਾਂ ਜਾਓ ਜਾਂ ⌘1–9 ਨਾਲ ਸਿੱਧਾ ਜਾਓ। ⌘Y ਨਾਲ ਕਲਿੱਪ ਲੈਣ ਤੋਂ ਪਹਿਲਾਂ ਉਸਨੂੰ ਦੇਖ ਲਓ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premikajte se z ↑↓ ali skočite z ⌘1–9. ⌘Y pokaže vnos, preden ga vzamete."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ மூலம் நகருங்கள் அல்லது ⌘1–9 மூலம் தாவுங்கள். ஒரு கிளிப்பை எடுக்கும் முன் ⌘Y அதைக் காட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓తో కదలండి లేదా ⌘1–9తో జంప్ చేయండి. క్లిప్‌ను తీసుకునే ముందు ⌘Y దాన్ని చూపిస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "↑↓ سے حرکت کریں یا ⌘1–9 سے سیدھا جائیں۔ ⌘Y سے کلپ لینے سے پہلے اسے دیکھ لیں۔"
          }
        }
      }
    },
