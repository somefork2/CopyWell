        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଧାଡ଼ିର ପରବର୍ତ୍ତୀ ଆଇଟମକୁ କ୍ଲିପବୋର୍ଡରେ ରଖନ୍ତୁ"
