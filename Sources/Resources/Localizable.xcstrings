    "Warm off-white, easier on the eyes in daylight.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبيض مائل للدفء، أريح للعين في ضوء النهار."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc trencat càlid, més descansat per als ulls amb llum de dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplá lomená bílá, za denního světla šetrnější k očím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm råhvid, nemmere for øjnene i dagslys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmes Gebrochenweiß, bei Tageslicht angenehmer für die Augen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζεστό υπόλευκο, πιο ξεκούραστο στο φως της ημέρας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm off-white, easier on the eyes in daylight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanco roto cálido, más agradable a la vista con luz de día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämmin luonnonvalkoinen, helpompi silmille päivänvalossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanc cassé chaud, plus reposant en plein jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבן־שבור חמים, נוח יותר לעיניים באור יום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गर्म हल्का सफ़ेद, दिन की रोशनी में आँखों को आराम देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topla lomljena bijela, ugodnija oku na dnevnom svjetlu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meleg törtfehér, nappali fényben kíméletesebb a szemnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putih gading hangat, lebih nyaman di mata saat siang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bianco sporco caldo, più riposante alla luce del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かみのあるオフホワイト。日中に目が楽です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻한 아이보리. 낮에 눈이 덜 피로합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Putih gading yang hangat, lebih selesa pada mata di siang hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm knekt hvit, lettere for øynene i dagslys."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm gebroken wit, bij daglicht prettiger voor de ogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciepła złamana biel, przyjemniejsza dla oczu przy świetle dziennym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Branco quebrado e quente, mais confortável à luz do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Branco-sujo quente, mais descansado à luz do dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alb cald spre fildeș, mai odihnitor pentru ochi la lumina zilei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёплый молочно-белый, при дневном свете глазам легче."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teplá lomená biela, pri dennom svetle šetrnejšia k očiam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm brutet vit, skonsammare för ögonen i dagsljus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขาวนวลโทนอุ่น สบายตากว่าในเวลากลางวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıcak kırık beyaz; gün ışığında göze daha kolay gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Теплий молочно-білий, при денному світлі очам легше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trắng ngà ấm, dễ chịu cho mắt dưới ánh sáng ban ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温暖的米白色，白天看更护眼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫暖的米白色，白天看更護眼。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উষ্ণ অফ-হোয়াইট, দিনের আলোয় চোখের জন্য আরামদায়ক।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હૂંફાળો ઑફ-વ્હાઇટ, દિવસના પ્રકાશમાં આંખોને વધુ આરામદાયક."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೆಚ್ಚನೆಯ ಮಾಸಲು ಬಿಳಿ, ಹಗಲು ಬೆಳಕಿನಲ್ಲಿ ಕಣ್ಣಿಗೆ ಹಿತಕರ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇളംചൂടുള്ള ഓഫ്-വൈറ്റ്, പകൽവെളിച്ചത്തിൽ കണ്ണുകൾക്ക് ആയാസം കുറവ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उबदार ऑफ-व्हाइट, दिवसाच्या प्रकाशात डोळ्यांना सुखद."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଉଷ୍ମ ଅଫ୍-ହ୍ୱାଇଟ୍, ଦିନ ଆଲୋକରେ ଆଖି ପାଇଁ ଆରାମଦାୟକ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿੱਘਾ ਹਲਕਾ-ਚਿੱਟਾ, ਦਿਨ ਦੀ ਰੌਸ਼ਨੀ ਵਿੱਚ ਅੱਖਾਂ ਲਈ ਆਰਾਮਦਾਇਕ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplo belkasta, pri dnevni svetlobi prijaznejša do oči."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கதகதப்பான மங்கிய வெள்ளை, பகல் வெளிச்சத்தில் கண்களுக்கு இதமானது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెచ్చని ఆఫ్-వైట్, పగటి వెలుతురులో కళ్లకు హాయిగా ఉంటుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گرم ہلکا سفید، دن کی روشنی میں آنکھوں کے لیے آرام دہ۔"
          }
        }
      }
    },
