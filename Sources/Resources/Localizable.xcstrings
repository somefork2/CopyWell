            "state": "translated",
            "value": "จัดคิวหลายรายการแล้ววางทีละอัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç öğeyi sıraya dizin ve arka arkaya yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберіть кілька записів і вставляйте їх один за одним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xếp vài mục rồi dán lần lượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把几个条目排好队，一个接一个地粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把幾個項目排好，一個接一個貼上。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কয়েকটি ক্লিপ সারিতে রেখে একটির পর একটি পেস্ট করুন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘણી ક્લિપ કતારમાં મૂકો અને એક પછી એક પેસ્ટ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಲವು ಕ್ಲಿಪ್‌ಗಳನ್ನು ಸರದಿಯಲ್ಲಿಟ್ಟು ಒಂದರ ನಂತರ ಒಂದರಂತೆ ಅಂಟಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പല ക്ലിപ്പുകളും നിരയിലാക്കി ഒന്നിനുപുറകെ ഒന്നായി ഒട്ടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अनेक क्लिप्स रांगेत लावा आणि एकामागोमाग एक पेस्ट करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନେକ କ୍ଲିପ୍ ଧାଡ଼ିରେ ରଖି ଗୋଟିଏ ପରେ ଗୋଟିଏ ପେଷ୍ଟ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਈ ਕਲਿੱਪਾਂ ਕਤਾਰ ਵਿੱਚ ਲਗਾਓ ਅਤੇ ਉਨ੍ਹਾਂ ਨੂੰ ਇੱਕ ਤੋਂ ਬਾਅਦ ਇੱਕ ਪੇਸਟ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite več vnosov v vrsto in jih prilepite enega za drugim."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பல கிளிப்களை வரிசையில் சேர்த்து, ஒன்றன்பின் ஒன்றாக ஒட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అనేక క్లిప్‌లను క్యూలో పెట్టి, వాటిని ఒకదాని తర్వాత ఒకటి పేస్ట్ చేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کئی کلپس قطار میں لگائیں اور انہیں یکے بعد دیگرے پیسٹ کریں۔"
          }
        }
      }
    },
