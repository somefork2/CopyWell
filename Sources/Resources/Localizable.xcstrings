        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא נמחק אוטומטית. מסד הנתונים גדל עד שתנקו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी अपने आप नहीं हटता। जब तक आप साफ़ न करें, डेटाबेस बढ़ता रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne briše automatski. Baza raste dok je ne očistite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem törlődik automatikusan. Az adatbázis addig nő, amíg ki nem üríti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dihapus otomatis. Basis data terus bertambah sampai Anda membersihkannya."
