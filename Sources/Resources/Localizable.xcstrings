    "Clips and their stored images are removed permanently.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف العناصر والصور المحفوظة معها نهائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els elements i les imatges desades amb ells s’eliminen definitivament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky i obrázky uložené spolu s nimi budou trvale smazány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emnerne og de billeder, der er gemt sammen med dem, slettes permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge und die dazu gespeicherten Bilder werden endgültig entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία και οι εικόνες που φυλάσσονται μαζί τους διαγράφονται οριστικά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clips and their stored images are removed permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos y las imágenes guardadas con ellos se eliminan de forma permanente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteet ja niiden mukana tallennetut kuvat poistetaan pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments et les images conservées avec eux sont supprimés définitivement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריטים והתמונות שנשמרו איתם נמחקים לצמיתות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चीज़ें और उनके साथ सहेजी गई तस्वीरें हमेशा के लिए हट जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke i slike spremljene uz njih brišu se trajno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elemek és a velük tárolt képek véglegesen törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item beserta gambar yang tersimpan bersamanya dihapus permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi e le immagini conservate con essi vengono rimossi definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目と一緒に保存された画像は完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목과 함께 저장된 이미지가 영구적으로 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item dan imej yang disimpan bersamanya dipadam secara kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Objektene og bildene som er lagret sammen med dem, slettes for godt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items en de bewaarde afbeeldingen worden definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisy i zapisane z nimi obrazy zostaną usunięte trwale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens e as imagens guardadas com eles são removidos permanentemente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens e as imagens guardadas com eles são removidos permanentemente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele și imaginile salvate odată cu ele sunt șterse definitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи и сохранённые с ними изображения удаляются безвозвратно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky aj obrázky uložené s nimi sa natrvalo odstránia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekten och de bilder som sparats med dem tas bort permanent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการและรูปภาพที่เก็บไว้ด้วยกันจะถูกลบอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeler ve onlarla saklanan görüntüler kalıcı olarak silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи та збережені з ними зображення вилучаються назавжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục và hình ảnh lưu cùng chúng sẽ bị xoá vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目以及随之保存的图像将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目以及隨之儲存的影像會被永久刪除。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লিপ ও সেগুলোর সংরক্ষিত ছবি স্থায়ীভাবে সরিয়ে ফেলা হয়।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લિપ અને તેમની સંગ્રહિત છબીઓ કાયમ માટે દૂર કરવામાં આવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಲಿಪ್‌ಗಳು ಮತ್ತು ಅವುಗಳ ಸಂಗ್ರಹಿಸಿದ ಚಿತ್ರಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലിപ്പുകളും അവയ്ക്കൊപ്പം സംഭരിച്ച ചിത്രങ്ങളും ശാശ്വതമായി നീക്കം ചെയ്യപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिप्स आणि त्यांच्यासोबत साठवलेल्या इमेजेस कायमच्या काढून टाकल्या जातात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ୍ଲିପଗୁଡ଼ିକ ଏବଂ ସେଗୁଡ଼ିକର ସଂରକ୍ଷିତ ଛବି ସ୍ଥାୟୀ ଭାବେ କାଢ଼ି ଦିଆଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਲਿੱਪਾਂ ਅਤੇ ਉਨ੍ਹਾਂ ਦੀਆਂ ਸਟੋਰ ਕੀਤੀਆਂ ਤਸਵੀਰਾਂ ਸਥਾਈ ਤੌਰ ’ਤੇ ਹਟਾ ਦਿੱਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnosi in njihove shranjene slike bodo trajno odstranjeni."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிளிப்களும் அவற்றின் சேமிக்கப்பட்ட படங்களும் நிரந்தரமாக அகற்றப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్లిప్‌లు, వాటి నిల్వ చేసిన చిత్రాలు శాశ్వతంగా తీసివేయబడతాయి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلپس اور ان کی محفوظ تصاویر مستقل طور پر ہٹا دی جاتی ہیں۔"
          }
        }
      }
    },
