        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidite što najviše kopirate, iz kojih aplikacija i kako vam povijest raste s vremenom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézze meg, mit másol a legtöbbet, mely alkalmazásokból, és hogyan nő az előzménye az idővel."
