    "Near-black with a muted brass accent.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسود تقريبًا مع لمسة نحاسية هادئة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gairebé negre, amb un toc discret de llautó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Téměř černá s tlumeným mosazným akcentem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Næsten sort med en dæmpet messingtone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast schwarz mit gedämpftem Messingakzent."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδόν μαύρο με διακριτική ορειχάλκινη πινελιά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near-black with a muted brass accent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi negro con un acento latón discreto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähes musta, vaimealla messinkisävyllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque noir, avec un accent laiton discret."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמעט שחור, עם גוון פליז עדין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग काला, हल्के पीतली रंग के साथ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotovo crna s prigušenim mjedenim naglaskom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szinte fekete, visszafogott sárgaréz árnyalattal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hampir hitam dengan sentuhan kuningan yang kalem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi nero con un accento ottone discreto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほぼ黒に、落ち着いた真鍮色のアクセント。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 검정에 가까운 색과 차분한 황동빛 강조."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hampir hitam dengan sentuhan loyang yang lembut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesten svart med en dempet messingtone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna zwart, met een ingetogen messing accent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie czarny ze stonowanym mosiężnym akcentem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase preto, com um toque discreto de latão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase preto, com um toque discreto de latão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproape negru, cu un accent discret de alamă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти чёрный с приглушённым латунным акцентом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Takmer čierna s tlmeným mosadzným akcentom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästan svart med en dämpad mässingston."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกือบดำ ตัดด้วยสีทองเหลืองอ่อนๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siyaha yakın, dingin pirinç vurgulu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Майже чорний із приглушеним латунним акцентом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gần như đen với sắc đồng thau trầm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近乎纯黑，搭配低调的黄铜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "近乎純黑，搭配低調的黃銅色。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রায় কালো, সঙ্গে হালকা পিতলরঙা অ্যাকসেন্ট।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લગભગ કાળો, આછા પિત્તળ રંગના એક્સેન્ટ સાથે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಂದ ಹಿತ್ತಾಳೆ ಆಕ್ಸೆಂಟ್‌ನೊಂದಿಗೆ ಬಹುತೇಕ ಕಪ್ಪು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മങ്ങിയ പിച്ചള ആക്സന്റോടുകൂടിയ ഏതാണ്ട് കറുപ്പ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मंद पितळी ॲक्सेंटसह जवळजवळ काळा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମଳିନ ପିତ୍ତଳ ଆକ୍ସେଣ୍ଟ ସହ ପ୍ରାୟ କଳା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਲਕੇ ਪਿੱਤਲ ਰੰਗ ਦੇ ਐਕਸੈਂਟ ਵਾਲਾ ਲਗਭਗ ਕਾਲਾ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skoraj črna z umirjenim medeninastim poudarkom."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மங்கலான பித்தளை அக்சென்ட்டுடன் கிட்டத்தட்டக் கருப்பு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మసక ఇత్తడి యాక్సెంట్‌తో దాదాపు నలుపు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تقریباً سیاہ، ہلکے پیتل رنگ کے ایکسنٹ کے ساتھ۔"
          }
        }
      }
    },
