        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, in rekening gebracht via je Apple-account en automatisch verlengd tot je opzegt.%@ Beheer of zeg op via App Store ▸ Abonnementen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ za %@, płatność przez konto Apple, automatyczne odnawianie do momentu anulowania.%@ Zarządzaj lub anuluj w App Store ▸ Subskrypcje."
