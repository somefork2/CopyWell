            "value": "CopyWell ला या Mac वर iCloud वापरण्याची परवानगी नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି Mac ରେ iCloud ବ୍ୟବହାର କରିବାକୁ CopyWell ର ଅନୁମତି ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ਕੋਲ ਇਸ Mac ’ਤੇ iCloud ਵਰਤਣ ਦੀ ਇਜਾਜ਼ਤ ਨਹੀਂ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nima dovoljenja za uporabo iClouda v tem Macu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac-இல் iCloud-ஐப் பயன்படுத்த CopyWell-க்கு அனுமதி இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Macలో iCloudను ఉపయోగించడానికి CopyWellకు అనుమతి లేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell کو اس Mac پر iCloud استعمال کرنے کی اجازت نہیں ہے۔"
          }
        }
      }
    },
