    "If you have just allowed Screen Recording, macOS applies it only after CopyWell is reopened.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت قد سمحت للتو بتسجيل الشاشة، فلن يطبّقه macOS إلا بعد إعادة فتح CopyWell."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si acabes de permetre la gravació de pantalla, el macOS no l’aplica fins que tornes a obrir el CopyWell."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jste nahrávání obrazovky právě povolili, macOS ho uplatní až po novém otevření CopyWellu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lige har tilladt skærmoptagelse, anvender macOS det først, når CopyWell er åbnet igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Bildschirmaufnahme gerade erst erlaubt hast, übernimmt macOS das erst, wenn CopyWell neu geöffnet wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν μόλις επιτρέψατε την εγγραφή οθόνης, το macOS την εφαρμόζει μόνο αφού ανοίξει ξανά το CopyWell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si acabas de permitir la grabación de pantalla, macOS no lo aplica hasta que vuelves a abrir CopyWell."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sallit näytön tallennuksen juuri, macOS ottaa sen käyttöön vasta, kun CopyWell avataan uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous venez d’autoriser l’enregistrement de l’écran, macOS n’en tient compte qu’après la réouverture de CopyWell."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם זה עתה אישרתם הקלטת מסך, macOS יחיל זאת רק לאחר ש-CopyWell ייפתח מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपने अभी-अभी स्क्रीन रिकॉर्डिंग की अनुमति दी है, तो macOS इसे CopyWell को दोबारा खोलने के बाद ही लागू करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako ste upravo dopustili snimanje zaslona, macOS to primjenjuje tek nakon ponovnog otvaranja CopyWella."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha most engedélyezte a képernyőfelvételt, a macOS csak a CopyWell újranyitása után alkalmazza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda baru saja mengizinkan Perekaman Layar, macOS baru menerapkannya setelah CopyWell dibuka ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai appena consentito la registrazione schermo, macOS la applica solo dopo la riapertura di CopyWell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録を許可したばかりの場合、macOSはCopyWellを開き直した後にそれを適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 화면 기록을 허용했다면 macOS는 CopyWell을 다시 연 후에 이를 적용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda baru membenarkan Rakaman Skrin, macOS hanya menggunakannya selepas CopyWell dibuka semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du nettopp har tillatt skjermopptak, tar macOS det i bruk først når CopyWell er åpnet på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je schermopname net hebt toegestaan, past macOS dit pas toe nadat CopyWell opnieuw is geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli właśnie zezwolono na nagrywanie ekranu, macOS zastosuje to dopiero po ponownym otwarciu CopyWell."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você acabou de permitir a Gravação de Tela, o macOS só aplica isso depois que o CopyWell é reaberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acabou de permitir a gravação do ecrã, o macOS só a aplica depois de o CopyWell ser reaberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă tocmai ați permis înregistrarea ecranului, macOS o aplică doar după ce CopyWell este redeschis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы только что разрешили запись экрана, macOS применит это только после перезапуска CopyWell."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak ste práve povolili nahrávanie obrazovky, macOS to uplatní až po opätovnom otvorení CopyWellu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du nyss har tillåtit skärminspelning tillämpar macOS det först när CopyWell har öppnats igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณเพิ่งอนุญาตการบันทึกหน้าจอ macOS จะใช้สิทธิ์นี้หลังจากเปิด CopyWell ใหม่เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kaydına az önce izin verdiyseniz macOS bunu ancak CopyWell yeniden açıldıktan sonra uygular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви щойно дозволили запис екрана, macOS застосує це лише після перезапуску CopyWell."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn vừa cho phép ghi màn hình, macOS chỉ áp dụng sau khi mở lại CopyWell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你刚刚允许了录屏，macOS 要在重新打开 CopyWell 后才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你剛允許螢幕錄製，macOS 要在重新打開 CopyWell 後才會套用。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যদি এইমাত্র স্ক্রিন রেকর্ডিংয়ের অনুমতি দিয়ে থাকেন, তাহলে CopyWell আবার খোলার পরেই macOS তা কার্যকর করে।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમે હમણાં જ સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપી હોય, તો CopyWell ફરી ખોલ્યા પછી જ macOS તેને લાગુ કરે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈಗಷ್ಟೇ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಅನುಮತಿಸಿದ್ದರೆ, CopyWell ಅನ್ನು ಮತ್ತೆ ತೆರೆದ ನಂತರವೇ macOS ಅದನ್ನು ಅನ್ವಯಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഇപ്പോൾ സ്ക്രീൻ റെക്കോർഡിംഗ് അനുവദിച്ചതേയുള്ളൂവെങ്കിൽ, CopyWell വീണ്ടും തുറന്നതിന് ശേഷം മാത്രമേ macOS അത് പ്രാബല്യത്തിലാക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही नुकतीच स्क्रीन रेकॉर्डिंगला परवानगी दिली असल्यास, CopyWell पुन्हा उघडल्यानंतरच macOS ती लागू करते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯଦି ଆପଣ ଏବେ ସ୍କ୍ରିନ୍ ରେକର୍ଡିଂକୁ ଅନୁମତି ଦେଇଛନ୍ତି, ତେବେ CopyWell ପୁଣି ଖୋଲିବା ପରେ ହିଁ macOS ତାହା ଲାଗୁ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੇ ਤੁਸੀਂ ਹੁਣੇ ਸਕ੍ਰੀਨ ਰਿਕਾਰਡਿੰਗ ਦੀ ਇਜਾਜ਼ਤ ਦਿੱਤੀ ਹੈ, ਤਾਂ macOS ਇਸਨੂੰ CopyWell ਦੁਬਾਰਾ ਖੋਲ੍ਹਣ ਤੋਂ ਬਾਅਦ ਹੀ ਲਾਗੂ ਕਰਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če ste pravkar dovolili snemanje zaslona, ga macOS uveljavi šele, ko CopyWell znova odprete."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இப்போதுதான் திரைப் பதிவை அனுமதித்திருந்தால், CopyWell மீண்டும் திறக்கப்பட்ட பிறகே macOS அதைச் செயல்படுத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పుడే స్క్రీన్ రికార్డింగ్‌ను అనుమతించినట్లయితే, CopyWellను మళ్లీ తెరిచిన తర్వాత మాత్రమే macOS దాన్ని వర్తింపజేస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر آپ نے ابھی اسکرین ریکارڈنگ کی اجازت دی ہے تو macOS اسے CopyWell کے دوبارہ کھلنے کے بعد ہی لاگو کرتا ہے۔"
          }
        }
      }
    },
