    "Pinboards and the paste stack are there when you need them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللوحات ورصة اللصق في متناولك عند الحاجة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els taulers i la pila d’enganxar hi són quan els necessites."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástěnky i zásobník vkládání jsou po ruce, když je potřebujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslagstavlerne og indsætningsstakken er der, når du har brug for dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinnwände und der Einfügestapel sind da, wenn du sie brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πίνακες και η στοίβα επικόλλησης είναι εκεί όταν τους χρειάζεστε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinboards and the paste stack are there when you need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tableros y la pila de pegado están ahí cuando los necesitas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taulut ja liitäpino ovat siellä, kun tarvitset niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tableaux et la pile de collage sont là quand vous en avez besoin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלוחות וערימת ההדבקה נמצאים שם כשצריך אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरत पड़ने पर बोर्ड और पेस्ट स्टैक वहीं मिलते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ploče i hrpa lijepljenja tu su kad vam zatrebaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A táblák és a beillesztési sor ott vannak, amikor szüksége van rájuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan dan tumpukan tempel siap saat Anda membutuhkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bacheche e la pila di incollaggio ci sono quando ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボードとペーストスタックは、必要なときにそこにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보드와 붙여넣기 스택은 필요할 때 늘 그 자리에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan dan timbunan tampal ada apabila anda memerlukannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppslagstavlene og limstabelen er der når du trenger dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikborden en de plakstapel zijn er wanneer je ze nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablice i stos wklejania są pod ręką, kiedy ich potrzebujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadros e a pilha de colagem estão lá quando você precisa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quadros e a pilha de colagem estão lá quando precisa deles."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Panourile și teancul de lipire sunt acolo când aveți nevoie de ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доски и стопка вставки всегда под рукой."
