            "value": "कुछ कॉपी करें, वह यहाँ दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirajte nešto i pojavit će se ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Másoljon valamit, és itt megjelenik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin sesuatu dan ia akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia qualcosa e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かをコピーするとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무언가 복사하면 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin sesuatu dan ia akan muncul di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier noe, så vises det her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer iets en het verschijnt hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj coś, a pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie algo e aparecerá aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie algo e aparecerá aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiați ceva și va apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте что-нибудь, и оно появится здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo skopírujte a objaví sa to tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera något så visas det här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกบางอย่างแล้วมันจะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey kopyalayın, burada görünsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіюйте щось, і воно з’явиться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép thứ gì đó và nó sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝点什么，它就会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝點什麼，它就會出現在這裡。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু কপি করুন, এখানে দেখা যাবে।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈક કૉપિ કરો અને તે અહીં દેખાશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನನ್ನಾದರೂ ನಕಲಿಸಿ, ಅದು ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്തെങ്കിലും പകർത്തുക, അത് ഇവിടെ ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीतरी कॉपी करा, ते येथे दिसेल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କିଛି କପି କରନ୍ତୁ, ତାହା ଏଠାରେ ଦେଖାଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਕਾਪੀ ਕਰੋ ਅਤੇ ਉਹ ਇੱਥੇ ਦਿਖਾਈ ਦੇਵੇਗਾ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirajte nekaj in pojavilo se bo tukaj."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதையாவது நகலெடுங்கள், அது இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదైనా కాపీ చేయండి, అది ఇక్కడ కనిపిస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ کاپی کریں اور وہ یہاں نظر آئے گا۔"
          }
        }
      }
    },
