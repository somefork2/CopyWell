        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സ്വകാര്യ iCloud ഡാറ്റാബേസിലേക്ക് കണക്റ്റ് ചെയ്തിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या खाजगी iCloud डेटाबेसशी कनेक्ट केले आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ବ୍ୟକ୍ତିଗତ iCloud ଡାଟାବେସ୍ ସହ ସଂଯୁକ୍ତ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਨਿੱਜੀ iCloud ਡਾਟਾਬੇਸ ਨਾਲ ਕਨੈਕਟ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezano z vašo zasebno zbirko podatkov iCloud."
