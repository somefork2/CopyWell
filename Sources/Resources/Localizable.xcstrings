          "stringUnit": {
            "state": "translated",
            "value": "Історія буфера обміну на цьому Mac недоступна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử bảng nhớ tạm không khả dụng trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上无法使用剪贴板历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 無法使用剪貼板記錄。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এ ক্লিপবোর্ডের ইতিহাস উপলভ্য নয়।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Mac પર ક્લિપબોર્ડ ઇતિહાસ ઉપલબ્ધ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Mac ನಲ್ಲಿ ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಇತಿಹಾಸ ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Mac-ൽ ക്ലിപ്പ്ബോർഡ് ചരിത്രം ലഭ്യമല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac वर क्लिपबोर्ड इतिहास उपलब्ध नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି Mac ରେ କ୍ଲିପବୋର୍ଡ ଇତିହାସ ଉପଲବ୍ଧ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Mac ’ਤੇ ਕਲਿੱਪਬੋਰਡ ਇਤਿਹਾਸ ਉਪਲਬਧ ਨਹੀਂ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgodovina odložišča v tem Macu ni na voljo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac-இல் கிளிப்போர்டு வரலாறு கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Macలో క్లిప్‌బోర్డ్ చరిత్ర అందుబాటులో లేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac پر کلپ بورڈ ہسٹری دستیاب نہیں ہے۔"
          }
        }
      }
