    "The saved history could not be opened. This session is being kept in memory only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح السجل المحفوظ. تُحفظ هذه الجلسة في الذاكرة فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut obrir l’historial desat. Aquesta sessió es manté només a la memòria."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženou historii se nepodařilo otevřít. Toto sezení je uchováno pouze v paměti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den arkiverede historik kunne ikke åbnes. Denne omgang gemmes kun i hukommelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesicherte Verlauf konnte nicht geöffnet werden. Diese Sitzung wird nur im Arbeitsspeicher gehalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό το άνοιγμα του αποθηκευμένου ιστορικού. Αυτή η συνεδρία κρατείται μόνο στη μνήμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved history could not be opened. This session is being kept in memory only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir el historial guardado. Esta sesión se mantiene solo en memoria."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettua historiaa ei voitu avata. Tämä istunto säilytetään vain muistissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique enregistré n’a pas pu être ouvert. Cette session est conservée en mémoire seulement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לפתוח את ההיסטוריה השמורה. ההפעלה הזו נשמרת בזיכרון בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया इतिहास खुल नहीं सका। यह सत्र सिर्फ़ मेमोरी में रखा जा रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljenu povijest nije moguće otvoriti. Ova se sesija čuva samo u memoriji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett előzményeket nem sikerült megnyitni. Ez a munkamenet csak a memóriában marad meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat tersimpan tidak dapat dibuka. Sesi ini hanya disimpan di memori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
