          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna suscripción activa para esta cuenta de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle Apple-tilille ei löytynyt voimassa olevaa tilausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement actif n’a été trouvé pour ce compte Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא מינוי פעיל לחשבון Apple הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Apple खाते के लिए कोई चालू सदस्यता नहीं मिली।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ovaj Apple račun nije pronađena aktivna pretplata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található aktív előfizetés ehhez az Apple-fiókhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan langganan aktif untuk Akun Apple ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun abbonamento attivo trovato per questo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple アカウントで有効なサブスクリプションは見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정에서 사용 중인 구독을 찾지 못했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada langganan aktif ditemui untuk Akaun Apple ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen aktive abonnementer for denne Apple-kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen actief abonnement gevonden voor deze Apple Account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono aktywnej subskrypcji dla tego konta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma assinatura ativa foi encontrada para esta conta Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrada nenhuma subscrição ativa para esta conta Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a găsit niciun abonament activ pentru acest cont Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого аккаунта Apple активная подписка не найдена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre tento účet Apple sa nenašlo žiadne aktívne predplatné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktiv prenumeration hittades för det här Apple-kontot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบการสมัครสมาชิกที่ใช้งานอยู่สำหรับบัญชี Apple นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabı için etkin abonelik bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього облікового запису Apple активної передплати не знайдено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy gói đăng ký đang hoạt động cho Tài khoản Apple này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到此 Apple 账户的有效订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此 Apple 帳號的有效訂閱。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Apple অ্যাকাউন্টে কোনো সক্রিয় সাবস্ক্রিপশন পাওয়া যায়নি।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Apple એકાઉન્ટ માટે કોઈ સક્રિય સબ્સ્ક્રિપ્શન મળ્યું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Apple ಖಾತೆಗೆ ಯಾವುದೇ ಸಕ್ರಿಯ ಚಂದಾದಾರಿಕೆ ಕಂಡುಬಂದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Apple അക്കൗണ്ടിന് സജീവമായ സബ്സ്ക്രിപ്ഷനൊന്നും കണ്ടെത്തിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Apple खात्यासाठी कोणतीही सक्रिय सदस्यता आढळली नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି Apple ଆକାଉଣ୍ଟ ପାଇଁ କୌଣସି ସକ୍ରିୟ ସଦସ୍ୟତା ମିଳିଲା ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Apple ਖਾਤੇ ਲਈ ਕੋਈ ਕਿਰਿਆਸ਼ੀਲ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਨਹੀਂ ਮਿਲੀ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ta račun Apple ni bila najdena nobena aktivna naročnina."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Apple கணக்கிற்குச் செயலில் உள்ள சந்தா எதுவும் கண்டறியப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Apple ఖాతాకు యాక్టివ్ సబ్‌స్క్రిప్షన్ ఏదీ కనుగొనబడలేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Apple اکاؤنٹ کے لیے کوئی فعال سبسکرپشن نہیں ملی۔"
          }
        }
      }
    },
