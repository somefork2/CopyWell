        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମ୍ବେଦନଶୀଳ କ୍ଲିପ୍ ଏକ୍ସପୋର୍ଟରେ କେବେ ବି ସାମିଲ ହୁଏ ନାହିଁ।"
