          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng ít nhất một trong các phím ⌘, ⌥ hoặc ⌃."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少使用 ⌘、⌥ 或 ⌃ 中的一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請至少使用 ⌘、⌥ 或 ⌃ 其中一個。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ বা ⌃-এর অন্তত একটি ব্যবহার করুন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ અથવા ⌃માંથી ઓછામાં ઓછું એક વાપરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ ಅಥವಾ ⌃ ಇವುಗಳಲ್ಲಿ ಕನಿಷ್ಠ ಒಂದನ್ನು ಬಳಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ അല്ലെങ്കിൽ ⌃ എന്നിവയിൽ ഒന്നെങ്കിലും ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ किंवा ⌃ पैकी किमान एक वापरा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ କିମ୍ବା ⌃ ମଧ୍ୟରୁ ଅତି କମରେ ଗୋଟିଏ ବ୍ୟବହାର କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ ਜਾਂ ⌃ ਵਿੱਚੋਂ ਘੱਟੋ-ਘੱਟ ਇੱਕ ਵਰਤੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite vsaj eno od tipk ⌘, ⌥ ali ⌃."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ அல்லது ⌃ இவற்றில் குறைந்தது ஒன்றையாவது பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘, ⌥ లేదా ⌃లలో కనీసం ఒకదాన్ని ఉపయోగించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘، ⌥ یا ⌃ میں سے کم از کم ایک استعمال کریں۔"
          }
        }
      }
    },
    "Use the colour this theme was designed around": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم اللون الذي صُممت حوله هذه السمة"
          }
