            "value": "Posa diversos elements en cua i enganxa’ls un darrere l’altre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařaďte několik položek za sebe a vkládejte je jednu po druhé."
          }
        },
        "da": {
          "stringUnit": {
