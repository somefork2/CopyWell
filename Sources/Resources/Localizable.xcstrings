    "Plans are unavailable right now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطط غير متوفرة حاليًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix els plans no estan disponibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarify teď nejsou k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementerne er ikke tilgængelige lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tarife sind gerade nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα προγράμματα δεν είναι διαθέσιμα αυτή τη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans are unavailable right now."
          }
