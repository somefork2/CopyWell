        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এনক্রিপ্ট করে সংরক্ষিত; প্রিভিউতে দেখানো হয় না।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એન્ક્રિપ્ટ કરીને સંગ્રહિત; પ્રિવ્યૂમાં બતાવાતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ; ಪೂರ್ವವೀಕ್ಷಣೆಗಳಲ್ಲಿ ತೋರಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എൻക്രിപ്റ്റ് ചെയ്ത് സംഭരിച്ചിരിക്കുന്നു; പ്രിവ്യൂകളിൽ കാണിക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एन्क्रिप्ट करून साठवलेले; पूर्वावलोकनात दाखवले जात नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏନକ୍ରିପ୍ଟ କରି ସଂରକ୍ଷିତ; ପ୍ରିଭ୍ୟୁରେ ଦେଖାଯାଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਨਕ੍ਰਿਪਟ ਕਰਕੇ ਸਟੋਰ ਕੀਤੀ; ਪ੍ਰੀਵਿਊ ਵਿੱਚ ਨਹੀਂ ਦਿਖਾਈ ਜਾਂਦੀ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjeno šifrirano; ni prikazano v predogledih."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மறையாக்கப்பட்டுச் சேமிக்கப்பட்டது; முன்னோட்டங்களில் காட்டப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎన్‌క్రిప్ట్ చేసి నిల్వ చేయబడింది; ప్రివ్యూలలో చూపబడదు."
          }
        },
        "ur": {
