          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্দিষ্ট সময়ের চেয়ে পুরোনো ক্লিপ স্বয়ংক্রিয়ভাবে সরিয়ে দিন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલા સમય કરતાં જૂની ક્લિપ આપમેળે દૂર કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಅವಧಿಗಿಂತ ಹಳೆಯ ಕ್ಲಿಪ್‌ಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ತೆಗೆದುಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത കാലയളവിനേക്കാൾ പഴയ ക്ലിപ്പുകൾ സ്വയമേവ നീക്കം ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या कालावधीपेक्षा जुन्या क्लिप्स आपोआप काढून टाका."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଛାଯାଇଥିବା ସମୟଠାରୁ ପୁରୁଣା କ୍ଲିପଗୁଡ଼ିକୁ ସ୍ୱୟଂଚାଳିତ ଭାବେ କାଢ଼ି ଦିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੀ ਹੋਈ ਉਮਰ ਤੋਂ ਪੁਰਾਣੀਆਂ ਕਲਿੱਪਾਂ ਆਪਣੇ-ਆਪ ਹਟਾਓ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno odstrani vnose, starejše od izbrane starosti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த காலத்தைவிடப் பழைய கிளிப்களைத் தானாக அகற்றும்."
          }
