        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางรายการถัดไปในคิวลงคลิปบอร์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki öğeyi panoya koy"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покласти наступний запис із черги в буфер обміну"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa mục kế tiếp trong hàng vào bảng nhớ tạm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
