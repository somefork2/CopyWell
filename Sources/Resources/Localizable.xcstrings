          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, debiteras via ditt Apple-konto och förnyas automatiskt tills du säger upp.%@ Hantera eller säg upp i App Store ▸ Prenumerationer."
