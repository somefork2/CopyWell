    "Subscribe to carry on using CopyWell. Nothing has been deleted — your history comes back the moment a subscription is active.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك لمواصلة استخدام CopyWell. لم يُحذف أي شيء — يعود سجلك في اللحظة التي يصبح فيها الاشتراك سارياً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriu-t’hi per continuar fent servir el CopyWell. No s’ha esborrat res: l’historial torna en el moment que hi hagi una subscripció activa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořiďte si předplatné, abyste mohli CopyWell používat dál. Nic nebylo smazáno – historie se vrátí ve chvíli, kdy bude předplatné aktivní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn et abonnement for at blive ved med at bruge CopyWell. Intet er blevet slettet – din historik er tilbage i samme øjeblik, et abonnement er aktivt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe ein Abo ab, um CopyWell weiter zu nutzen. Es wurde nichts gelöscht – dein Verlauf ist sofort wieder da, sobald ein Abo aktiv ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγγραφείτε για να συνεχίσετε να χρησιμοποιείτε το CopyWell. Δεν έχει διαγραφεί τίποτα — το ιστορικό σας επιστρέφει τη στιγμή που ενεργοποιείται μια συνδρομή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to carry on using CopyWell. Nothing has been deleted — your history comes back the moment a subscription is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete para seguir usando CopyWell. No se ha borrado nada: tu historial vuelve en cuanto haya una suscripción activa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaa jatkaaksesi CopyWellin käyttöä. Mitään ei ole poistettu – historiasi palaa heti, kun tilaus on voimassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous pour continuer à utiliser CopyWell. Rien n’a été supprimé : votre historique revient dès qu’un abonnement est actif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הירשמו כדי להמשיך להשתמש ב-CopyWell. שום דבר לא נמחק — ההיסטוריה שלכם חוזרת ברגע שמינוי הופך לפעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell इस्तेमाल करते रहने के लिए सदस्यता लें। कुछ भी मिटाया नहीं गया — सदस्यता चालू होते ही आपका इतिहास लौट आता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplatite se kako biste i dalje koristili CopyWell. Ništa nije izbrisano — povijest se vraća onog trenutka kad pretplata postane aktivna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fizessen elő, hogy tovább használhassa a CopyWellt. Semmi nem törlődött – az előzményei abban a pillanatban visszatérnek, amint az előfizetés él."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlanggananlah untuk terus memakai CopyWell. Tidak ada yang dihapus — riwayat Anda kembali begitu langganan aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati per continuare a usare CopyWell. Non è stato cancellato nulla: la cronologia torna appena un abbonamento è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellを使い続けるには登録してください。何も削除していません。登録すれば履歴はすぐに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell을 계속 쓰려면 구독하세요. 삭제된 것은 없습니다. 구독이 활성화되는 순간 기록이 돌아옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganlah untuk terus menggunakan CopyWell. Tiada apa-apa dipadam — sejarah anda kembali sebaik sahaja langganan aktif."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonner for å fortsette å bruke CopyWell. Ingenting er slettet – historikken er tilbake i samme øyeblikk som et abonnement er aktivt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een abonnement om CopyWell te blijven gebruiken. Er is niets verwijderd — je geschiedenis is er weer zodra een abonnement actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykup subskrypcję, aby dalej korzystać z CopyWell. Nic nie zostało usunięte — historia wróci w chwili, gdy subskrypcja stanie się aktywna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine para continuar usando o CopyWell. Nada foi apagado — seu histórico volta assim que houver uma assinatura ativa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscreva para continuar a usar o CopyWell. Nada foi apagado — o seu histórico volta assim que houver uma subscrição ativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonați-vă pentru a folosi CopyWell în continuare. Nu s-a șters nimic — istoricul revine în clipa în care abonamentul devine activ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформите подписку, чтобы продолжить пользоваться CopyWell. Ничего не удалено — история вернётся в тот же момент, как подписка станет активной."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predplaťte si, aby ste mohli CopyWell používať ďalej. Nič nebolo odstránené – história sa vráti vo chvíli, keď bude predplatné aktívne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerera för att fortsätta använda CopyWell. Ingenting har tagits bort – din historik är tillbaka i samma stund som en prenumeration gäller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมัครสมาชิกเพื่อใช้ CopyWell ต่อ ไม่มีอะไรถูกลบ — ประวัติของคุณจะกลับมาทันทีที่การสมัครสมาชิกมีผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell’i kullanmaya devam etmek için abone olun. Hiçbir şey silinmedi — abonelik etkinleştiği anda geçmişiniz geri gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформіть передплату, щоб продовжити користуватися CopyWell. Нічого не вилучено — історія повернеться тієї ж миті, щойно передплата стане активною."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng ký để tiếp tục dùng CopyWell. Không có gì bị xoá — lịch sử của bạn trở lại ngay khi gói đăng ký có hiệu lực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅后可继续使用 CopyWell。没有删除任何内容——订阅生效的那一刻，历史就回来了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱後可繼續使用 CopyWell。沒有刪除任何內容——訂閱生效的那一刻，記錄就回來了。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ব্যবহার চালিয়ে যেতে সাবস্ক্রাইব করুন। কিছুই মুছে ফেলা হয়নি — সাবস্ক্রিপশন সক্রিয় হওয়ামাত্র আপনার ইতিহাস ফিরে আসবে।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell વાપરવાનું ચાલુ રાખવા સબ્સ્ક્રાઇબ કરો. કંઈ પણ ડિલીટ કરવામાં આવ્યું નથી — સબ્સ્ક્રિપ્શન સક્રિય થતાં જ તમારો ઇતિહાસ પાછો આવી જશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಲು ಚಂದಾದಾರರಾಗಿ. ಏನನ್ನೂ ಅಳಿಸಲಾಗಿಲ್ಲ — ಚಂದಾದಾರಿಕೆ ಸಕ್ರಿಯವಾದ ತಕ್ಷಣ ನಿಮ್ಮ ಇತಿಹಾಸ ಮರಳಿ ಬರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ഉപയോഗം തുടരാൻ സബ്സ്ക്രൈബ് ചെയ്യുക. ഒന്നും ഇല്ലാതാക്കിയിട്ടില്ല — ഒരു സബ്സ്ക്രിപ്ഷൻ സജീവമാകുന്ന നിമിഷം നിങ്ങളുടെ ചരിത്രം തിരികെ വരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell वापरत राहण्यासाठी सदस्यता घ्या. काहीही हटवलेले नाही — सदस्यता सक्रिय होताच तुमचा इतिहास परत येतो."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ବ୍ୟବହାର ଜାରି ରଖିବାକୁ ସଦସ୍ୟତା ନିଅନ୍ତୁ। କିଛି ଡିଲିଟ୍ ହୋଇନାହିଁ — ସଦସ୍ୟତା ସକ୍ରିୟ ହେବା ମାତ୍ରେ ଆପଣଙ୍କ ଇତିହାସ ଫେରିଆସିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ਵਰਤਦੇ ਰਹਿਣ ਲਈ ਸਬਸਕ੍ਰਾਈਬ ਕਰੋ। ਕੁਝ ਵੀ ਮਿਟਾਇਆ ਨਹੀਂ ਗਿਆ — ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਕਿਰਿਆਸ਼ੀਲ ਹੁੰਦੇ ਹੀ ਤੁਹਾਡਾ ਇਤਿਹਾਸ ਵਾਪਸ ਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naročite se, če želite še naprej uporabljati CopyWell. Nič ni bilo izbrisano — vaša zgodovina se vrne takoj, ko je naročnina aktivna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell-ஐத் தொடர்ந்து பயன்படுத்தச் சந்தா செலுத்துங்கள். எதுவும் நீக்கப்படவில்லை — சந்தா செயலுக்கு வந்த உடனே உங்கள் வரலாறு திரும்ப வரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWellను ఉపయోగించడం కొనసాగించడానికి సబ్‌స్క్రయిబ్ చేయండి. ఏదీ తొలగించబడలేదు — సబ్‌స్క్రిప్షన్ యాక్టివ్ అయిన వెంటనే మీ చరిత్ర తిరిగి వస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell کا استعمال جاری رکھنے کے لیے سبسکرائب کریں۔ کچھ بھی حذف نہیں کیا گیا — سبسکرپشن فعال ہوتے ہی آپ کی ہسٹری واپس آ جاتی ہے۔"
          }
        }
      }
    },
