        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনের একটি অংশ বেছে নিন, মার্কআপ করুন, কপি বা সংরক্ষণ করুন"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્ક્રીનનો ભાગ પસંદ કરો, તેના પર માર્કઅપ કરો, કૉપિ કરો અથવા સાચવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ರೀನ್‌ನ ಭಾಗವನ್ನು ಆಯ್ಕೆಮಾಡಿ, ಮಾರ್ಕಪ್ ಮಾಡಿ, ನಕಲಿಸಿ ಅಥವಾ ಉಳಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ക്രീനിന്റെ ഒരു ഭാഗം തിരഞ്ഞെടുത്ത് മാർക്ക് അപ്പ് ചെയ്യുക, പകർത്തുകയോ സംരക്ഷിക്കുകയോ ചെയ്യുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनचा भाग निवडा, त्यावर मार्कअप करा, कॉपी किंवा सेव्ह करा"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍କ୍ରିନର ଏକ ଅଂଶ ବାଛନ୍ତୁ, ମାର୍କଅପ୍ କରନ୍ତୁ, କପି କିମ୍ବା ସେଭ୍ କରନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕ੍ਰੀਨ ਦਾ ਕੁਝ ਹਿੱਸਾ ਚੁਣੋ, ਉਸ ’ਤੇ ਨਿਸ਼ਾਨ ਲਗਾਓ, ਕਾਪੀ ਜਾਂ ਸੇਵ ਕਰੋ"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite del zaslona, ga označite, kopirajte ali shranite"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திரையின் ஒரு பகுதியைத் தேர்ந்தெடுத்து, குறிப்புகளைச் சேர்த்து, நகலெடு அல்லது சேமி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్క్రీన్‌లో కొంత భాగాన్ని ఎంచుకుని, మార్కప్ చేసి, కాపీ లేదా సేవ్ చేయి"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین کا کوئی حصہ منتخب کریں، اس پر نشانات لگائیں، کاپی یا محفوظ کریں"
          }
        }
      }
    },
