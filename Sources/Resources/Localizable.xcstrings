        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर क्लिपबोर्ड इतिहास उपलब्ध नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povijest međuspremnika nije dostupna na ovom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap előzményei nem érhetők el ezen a Macen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat papan klip tidak tersedia di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia degli appunti non è disponibile su questo Mac."
          }
        },
