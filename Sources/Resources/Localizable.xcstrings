    "Record an area or the whole screen, with or without the Mac's sound.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل منطقة أو الشاشة كلها، مع صوت الـ Mac أو بدونه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava una àrea o tota la pantalla, amb el so del Mac o sense."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávejte oblast nebo celou obrazovku, se zvukem Macu i bez něj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag et område eller hele skærmen med eller uden lyden fra din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Bereich oder den ganzen Bildschirm aufnehmen – mit oder ohne Ton des Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγγράψτε μια περιοχή ή όλη την οθόνη, με ή χωρίς τον ήχο του Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba un área o toda la pantalla, con o sin el sonido del Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna alue tai koko näyttö Macin äänen kanssa tai ilman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une zone ou tout l’écran, avec ou sans le son du Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקליטו אזור או את כל המסך, עם הצליל של ה-Mac או בלעדיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई क्षेत्र या पूरी स्क्रीन रिकॉर्ड करें, Mac की आवाज़ के साथ या उसके बिना।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimajte područje ili cijeli zaslon, sa zvukom Maca ili bez njega."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsen egy területet vagy a teljes képernyőt, a Mac hangjával vagy anélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam area atau seluruh layar, dengan atau tanpa suara Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un’area o l’intero schermo, con o senza l’audio del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲または画面全体を、Macのサウンドあり・なしで収録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역이나 전체 화면을 Mac 사운드와 함께 또는 사운드 없이 기록하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakam kawasan atau seluruh skrin, dengan atau tanpa bunyi Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta opp et område eller hele skjermen, med eller uten lyden fra Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een gebied of het hele scherm op, met of zonder het geluid van de Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywaj obszar lub cały ekran, z dźwiękiem Maca lub bez niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma área ou a tela inteira, com ou sem o som do Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma área ou o ecrã inteiro, com ou sem o som do Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrați o zonă sau tot ecranul, cu sau fără sunetul Mac-ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте область или весь экран — со звуком Mac или без него."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávajte oblasť alebo celú obrazovku, so zvukom Macu alebo bez neho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in ett område eller hela skärmen, med eller utan ljudet från datorn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกพื้นที่หรือทั้งหน้าจอ จะมีหรือไม่มีเสียงของ Mac ก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alanı ya da tüm ekranı, Mac’in sesiyle veya sessiz olarak kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте область або весь екран — зі звуком Mac або без нього."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi một vùng hoặc toàn màn hình, có hoặc không có âm thanh của máy Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制某个区域或整个屏幕，可选择是否录制 Mac 的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製某個區域或整個螢幕，可選擇是否錄製 Mac 的聲音。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি এলাকা বা পুরো স্ক্রিন রেকর্ড করুন, Mac-এর শব্দসহ বা ছাড়া।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિસ્તાર અથવા આખી સ્ક્રીન રેકોર્ડ કરો, Macના અવાજ સાથે કે વગર."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಪ್ರದೇಶ ಅಥವಾ ಸಂಪೂರ್ಣ ಸ್ಕ್ರೀನ್ ಅನ್ನು, Mac ನ ಶಬ್ದದೊಂದಿಗೆ ಅಥವಾ ಇಲ್ಲದೆ ರೆಕಾರ್ಡ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഭാഗമോ മുഴുവൻ സ്ക്രീനോ, Mac-ന്റെ ശബ്ദത്തോടെയോ അല്ലാതെയോ റെക്കോർഡ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखादे क्षेत्र किंवा संपूर्ण स्क्रीन रेकॉर्ड करा, Mac च्या आवाजासह किंवा त्याशिवाय."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଅଞ୍ଚଳ କିମ୍ବା ସମଗ୍ର ସ୍କ୍ରିନ୍ ରେକର୍ଡ କରନ୍ତୁ, Mac ର ଧ୍ୱନି ସହ କିମ୍ବା ବିନା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ਦੀ ਆਵਾਜ਼ ਸਮੇਤ ਜਾਂ ਉਸ ਤੋਂ ਬਿਨਾਂ, ਕੋਈ ਖੇਤਰ ਜਾਂ ਪੂਰੀ ਸਕ੍ਰੀਨ ਰਿਕਾਰਡ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posnemite območje ali cel zaslon, z zvokom Maca ali brez njega."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பகுதியையோ முழுத் திரையையோ, Mac-இன் ஒலியுடனோ அல்லது ஒலி இல்லாமலோ பதிவு செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ప్రాంతాన్ని లేదా మొత్తం స్క్రీన్‌ను, Mac శబ్దంతో లేదా అది లేకుండా రికార్డ్ చేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی حصہ یا پوری اسکرین ریکارڈ کریں، Mac کی آواز کے ساتھ یا اس کے بغیر۔"
          }
        }
      }
    },
    "Record an area or the whole screen; press again to stop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل منطقة أو الشاشة كلها؛ اضغط مرة أخرى للإيقاف"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava una àrea o tota la pantalla; torna a prémer per aturar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrát oblast nebo celou obrazovku; dalším stisknutím zastavíte"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag et område eller hele skærmen; tryk igen for at stoppe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Bereich oder den ganzen Bildschirm aufnehmen; zum Beenden erneut drücken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγγραφή περιοχής ή όλης της οθόνης· πατήστε ξανά για διακοπή"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar un área o toda la pantalla; vuelve a pulsar para detener"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna alue tai koko näyttö; lopeta painamalla uudelleen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer une zone ou tout l’écran ; appuyer à nouveau pour arrêter"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלטת אזור או את כל המסך; לחצו שוב כדי לעצור"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई क्षेत्र या पूरी स्क्रीन रिकॉर्ड करें; रोकने के लिए फिर से दबाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimajte područje ili cijeli zaslon; ponovno pritisnite za zaustavljanje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy terület vagy a teljes képernyő rögzítése; a leállításhoz nyomja meg újra"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam area atau seluruh layar; tekan lagi untuk berhenti"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un’area o l’intero schermo; premi di nuovo per interrompere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲または画面全体を収録。もう一度押すと停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역이나 전체 화면 기록, 다시 누르면 중단"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakam kawasan atau seluruh skrin; tekan sekali lagi untuk berhenti"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta opp et område eller hele skjermen; trykk igjen for å stoppe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een gebied of het hele scherm op; druk nogmaals om te stoppen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj obszar lub cały ekran; naciśnij ponownie, aby zatrzymać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravar uma área ou a tela inteira; pressione de novo para parar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravar uma área ou o ecrã inteiro; prima de novo para parar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează o zonă sau tot ecranul; apasă din nou pentru a opri"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать область или весь экран; нажмите ещё раз, чтобы остановить"
