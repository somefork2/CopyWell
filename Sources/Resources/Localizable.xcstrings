          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al %@, con cargo a tu cuenta de Apple y renovación automática hasta que la canceles.%@ Gestiónala o cancélala en App Store ▸ Suscripciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@, veloitetaan Apple-tililtäsi ja uusitaan automaattisesti, kunnes peruutat.%@ Hallinnoi tai peruuta: App Store ▸ Tilaukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par %@, facturé via votre compte Apple et renouvelé automatiquement jusqu’à résiliation.%@ Gérez ou résiliez dans l’App Store ▸ Abonnements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ל%@, החיוב דרך חשבון Apple שלכם וחידוש אוטומטי עד לביטול.%@ ניהול או ביטול ב‑App Store ◂ מינויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ प्रति %@, आपके Apple खाते से शुल्क लिया जाता है और रद्द करने तक अपने आप नवीनीकृत होता है।%@ App Store ▸ सदस्यताएँ में प्रबंधित या रद्द करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ po %@, naplaćuje se putem vašeg Apple računa i automatski se obnavlja dok ne otkažete.%@ Upravljajte ili otkažite u App Storeu ▸ Pretplate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ díjszabással, az Apple-fiókján keresztül számlázva, lemondásig automatikusan megújul.%@ Kezelés vagy lemondás: App Store ▸ Előfizetések."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
