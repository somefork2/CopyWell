    "Last day of your trial — everything is unlocked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر يوم في فترتك التجريبية — كل شيء متاح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Últim dia de la prova: tot està desbloquejat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední den zkušební doby – vše je odemčeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidste dag i din prøveperiode – alt er låst op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Tag deiner Testphase – alles ist freigeschaltet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τελευταία ημέρα της δοκιμής σας — όλα είναι ξεκλείδωτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last day of your trial — everything is unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Último día de tu prueba: todo está desbloqueado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeilujaksosi viimeinen päivä – kaikki on avattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier jour de votre essai : tout est débloqué."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היום האחרון של תקופת הניסיון — הכול פתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आज़माइश का आख़िरी दिन — सब कुछ खुला है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posljednji dan probnog razdoblja — sve je otključano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A próbaidőszak utolsó napja – minden nyitva áll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari terakhir masa coba Anda — semuanya terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimo giorno della prova: tutto è sbloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料期間の最終日です。すべて利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 마지막 날입니다. 모든 기능이 열려 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari terakhir percubaan anda — semuanya terbuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Siste dag av prøveperioden – alt er låst opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatste dag van je proefperiode — alles is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni dzień okresu próbnego — wszystko jest odblokowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Último dia do seu teste — tudo está liberado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Último dia do seu período experimental — está tudo desbloqueado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima zi a perioadei de probă — totul este deblocat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний день пробного периода — всё открыто."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posledný deň skúšobnej doby – všetko je odomknuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sista dagen av din provperiod – allt är upplåst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันสุดท้ายของการทดลองใช้ — ทุกอย่างปลดล็อกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme sürenizin son günü — her şey açık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останній день пробного періоду — усе відкрито."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày cuối của thời gian dùng thử — mọi thứ đều mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用的最后一天——所有功能都已解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用的最後一天——所有功能都已解鎖。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রায়ালের শেষ দিন — সবকিছু আনলক করা আছে।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ટ્રાયલનો છેલ્લો દિવસ — બધું અનલૉક છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ರಾಯೋಗಿಕ ಅವಧಿಯ ಕೊನೆಯ ದಿನ — ಎಲ್ಲವೂ ಅನ್‌ಲಾಕ್ ಆಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ട്രയലിന്റെ അവസാന ദിവസം — എല്ലാം അൺലോക്ക് ചെയ്തിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या चाचणीचा शेवटचा दिवस — सर्व काही अनलॉक आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ ଟ୍ରାଏଲର ଶେଷ ଦିନ — ସବୁକିଛି ଅନଲକ୍ ଅଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਟ੍ਰਾਇਲ ਦਾ ਆਖਰੀ ਦਿਨ — ਸਭ ਕੁਝ ਅਨਲੌਕ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadnji dan preizkusnega obdobja — vse je odklenjeno."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சோதனைக் காலத்தின் கடைசி நாள் — அனைத்தும் திறக்கப்பட்டுள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ట్రయల్‌లో చివరి రోజు — అన్నీ అన్‌లాక్ అయ్యాయి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ٹرائل کا آخری دن — سب کچھ ان لاک ہے۔"
          }
        }
      }
    },
