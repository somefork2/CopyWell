    "No active subscription was found for this Apple Account.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على اشتراك ساري لحساب Apple هذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat cap subscripció activa per a aquest compte d’Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento účet Apple nebylo nalezeno žádné aktivní předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet et aktivt abonnement til denne Apple-konto."
          }
        },
        "de": {
