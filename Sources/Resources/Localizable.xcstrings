        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪಿನ್‌ಬೋರ್ಡ್‌ಗಳು ಮತ್ತು ಪೇಸ್ಟ್ ಸ್ಟ್ಯಾಕ್ ನಿಮಗೆ ಬೇಕಾದಾಗ ಸಿದ್ಧವಾಗಿರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പിൻബോർഡുകളും പേസ്റ്റ് സ്റ്റാക്കും നിങ്ങൾക്ക് ആവശ്യമുള്ളപ്പോൾ തയ്യാറായിരിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पिनबोर्ड्स आणि पेस्ट स्टॅक गरज पडेल तेव्हा हजर असतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆବଶ୍ୟକ ସମୟରେ ପିନବୋର୍ଡ ଏବଂ ପେଷ୍ଟ ଷ୍ଟାକ୍ ଉପଲବ୍ଧ ରହେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿੰਨਬੋਰਡ ਅਤੇ ਪੇਸਟ ਸਟੈਕ ਲੋੜ ਪੈਣ ’ਤੇ ਹਾਜ਼ਰ ਹਨ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Table in sklad za lepljenje so na voljo, ko jih potrebujete."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேவைப்படும்போது பின்போர்டுகளும் ஒட்டு அடுக்கும் தயாராக இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు అవసరమైనప్పుడు పిన్‌బోర్డ్‌లు, పేస్ట్ స్టాక్ అందుబాటులో ఉంటాయి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پن بورڈز اور پیسٹ اسٹیک ضرورت پڑنے پر حاضر ہیں۔"
          }
        }
      }
    },
