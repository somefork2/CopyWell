          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está ocupado. O CopyWell voltará a tentar dentro de momentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud este ocupat. CopyWell va încerca din nou în scurt timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud занят. CopyWell скоро повторит попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je zaneprázdnený. CopyWell to o chvíľu skúsi znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud är upptaget. CopyWell försöker igen snart."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud กำลังไม่ว่าง CopyWell จะลองใหม่ในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud meşgul. CopyWell birazdan yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud зайнятий. CopyWell скоро повторить спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud đang bận. CopyWell sẽ thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 正忙。CopyWell 稍后会重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 忙碌中。CopyWell 稍後會重試。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ব্যস্ত আছে। CopyWell একটু পরে আবার চেষ্টা করবে।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud વ્યસ્ત છે. CopyWell થોડી વારમાં ફરી પ્રયાસ કરશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ಕಾರ್ಯನಿರತವಾಗಿದೆ. CopyWell ಸ್ವಲ್ಪ ಸಮಯದಲ್ಲಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud തിരക്കിലാണ്. CopyWell അൽപ്പസമയത്തിനകം വീണ്ടും ശ്രമിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud व्यस्त आहे. CopyWell थोड्या वेळाने पुन्हा प्रयत्न करेल."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ବ୍ୟସ୍ତ ଅଛି। CopyWell କିଛି ସମୟ ପରେ ପୁଣି ଚେଷ୍ଟା କରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਰੁੱਝਿਆ ਹੋਇਆ ਹੈ। CopyWell ਜਲਦੀ ਹੀ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੇਗਾ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je zaseden. CopyWell bo kmalu poskusil znova."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud பிஸியாக உள்ளது. CopyWell விரைவில் மீண்டும் முயலும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud బిజీగా ఉంది. CopyWell త్వరలో మళ్లీ ప్రయత్నిస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud مصروف ہے۔ CopyWell تھوڑی دیر میں دوبارہ کوشش کرے گا۔"
          }
        }
      }
    },
