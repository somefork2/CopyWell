        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಕಲಿಸಿದ್ದನ್ನು CopyWell ಇಟ್ಟುಕೊಳ್ಳುತ್ತದೆ, ಹೀಗಾಗಿ ನೀವು ಅದನ್ನು ನಂತರ ಮರಳಿ ಪಡೆಯಬಹುದು."
