            "value": "L’aspecte, i si el CopyWell fa algun so."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uiterlijk, en of CopyWell geluid maakt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utseendet, och om CopyWell ger ifrån sig ljud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udseendet, og om CopyWell siger lyd."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utseendet, og om CopyWell lager lyd."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulkoasu ja se, antaako CopyWell ääntä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląd oraz to, czy CopyWell wydaje dźwięk."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzhled a to, zda CopyWell vydává zvuk."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzhľad a to, či CopyWell vydáva zvuk."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgled i to oglašava li se CopyWell zvukom."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspectul și dacă CopyWell scoate vreun sunet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megjelenés, és hogy ad-e hangot a CopyWell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εμφάνιση, και αν το CopyWell βγάζει ήχο."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm ve CopyWell’in ses çıkarıp çıkarmayacağı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المظهر، وما إذا كان CopyWell يُصدر صوتاً."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המראה, והאם CopyWell משמיע צליל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूप-रंग, और यह कि CopyWell आवाज़ करे या नहीं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าตา และ CopyWell จะมีเสียงหรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diện mạo, và liệu CopyWell có phát ra âm thanh hay không."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
