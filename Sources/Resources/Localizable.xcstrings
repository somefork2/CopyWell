    "Your 30-day trial has ended. Subscribe to carry on using CopyWell.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت فترتك التجريبية البالغة ٣٠ يوماً. اشترك لمواصلة الاستخدام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva prova de 30 dies s’ha acabat. Subscriu-t’hi per continuar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše 30denní zkušební doba skončila. Pro další používání si pořiďte předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din prøveperiode på 30 dage er slut. Tegn et abonnement for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine 30-tägige Testphase ist vorbei. Schließe ein Abo ab, um CopyWell weiter zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δοκιμή των 30 ημερών τελείωσε. Εγγραφείτε για να συνεχίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 30-day trial has ended. Subscribe to carry on using CopyWell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba de 30 días ha terminado. Suscríbete para seguir usando CopyWell."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "30 päivän kokeilujaksosi on päättynyt. Tilaa jatkaaksesi CopyWellin käyttöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai de 30 jours est terminé. Abonnez-vous pour continuer à utiliser CopyWell."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקופת הניסיון בת 30 הימים הסתיימה. הירשמו כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी 30 दिन की आज़माइश ख़त्म हो गई। आगे इस्तेमाल करने के लिए सदस्यता लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše 30-dnevno probno razdoblje je završilo. Pretplatite se da biste nastavili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A 30 napos próbaideje véget ért. Fizessen elő a további használathoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa coba 30 hari Anda telah berakhir. Berlanggananlah untuk terus memakainya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova di 30 giorni è finita. Abbonati per continuare a usare CopyWell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間の無料期間が終了しました。使い続けるには登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 체험이 끝났습니다. 계속 쓰려면 구독하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
