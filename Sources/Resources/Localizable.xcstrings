    "Rebind every global shortcut to whatever you prefer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تعيين كل اختصار عام كما يناسبك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reassigna cada drecera global com et vagi millor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přiřaďte každé globální zkratce klávesy, které vám vyhovují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt hver global genvej til det, du foretrækker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belege jeden globalen Kurzbefehl so, wie es dir passt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάξτε κάθε γενική συντόμευση όπως προτιμάτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebind every global shortcut to whatever you prefer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasigna cada atajo global a lo que prefieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä jokainen yleinen oikopolku haluamaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redéfinissez chaque raccourci global comme vous le souhaitez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנו כל קיצור גלובלי למה שנוח לכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वैश्विक शॉर्टकट अपनी पसंद के अनुसार बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodijelite svakom globalnom prečacu tipke koje vam odgovaraju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendeljen át minden globális gyorsbillentyűt tetszés szerint."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah setiap pintasan global sesuai keinginan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riassegna ogni scorciatoia globale come preferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのグローバルショートカットを好きなキーに割り当て直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 전역 단축키를 원하는 대로 바꾸세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan semula setiap pintasan global mengikut kehendak anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett hver globale snarvei til det du foretrekker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs elke globale toetscombinatie toe zoals jij wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypisz każdy skrót globalny tak, jak Ci wygodnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefina cada atalho global do jeito que preferir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefina cada atalho global como preferir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reatribuiți fiecare scurtătură globală cum vă convine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переназначьте любое глобальное сочетание клавиш как вам удобно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priraďte každej globálnej skratke klávesy, ktoré vám vyhovujú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra varje globalt kortkommando till det du föredrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดปุ่มลัดส่วนกลางทุกอันใหม่ได้ตามใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her genel kısayolu dilediğiniz tuşlara atayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перепризначте будь-яке глобальне сполучення клавіш так, як вам зручно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gán lại mọi phím tắt toàn cục theo ý bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每个全局快捷键都改成你习惯的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把每個全域快速鍵都改成你習慣的。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি গ্লোবাল শর্টকাট আপনার পছন্দমতো বদলে নিন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ગ્લોબલ શૉર્ટકટ તમારી પસંદ મુજબ બદલો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿಯೊಂದು ಜಾಗತಿಕ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ನಿಮಗೆ ಇಷ್ಟವಾದ ಕೀಗಳಿಗೆ ಬದಲಾಯಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ഗ്ലോബൽ ഷോർട്ട്കട്ടും നിങ്ങൾക്കിഷ്ടമുള്ള കീകളിലേക്ക് മാറ്റുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक ग्लोबल शॉर्टकट तुमच्या आवडीनुसार बदला."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଗ୍ଲୋବାଲ୍ ସର୍ଟକଟକୁ ନିଜ ପସନ୍ଦ ଅନୁସାରେ ବଦଳାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਗਲੋਬਲ ਸ਼ਾਰਟਕੱਟ ਨੂੰ ਆਪਣੀ ਪਸੰਦ ਅਨੁਸਾਰ ਬਦਲੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako globalno bližnjico nastavite po svoje."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு உலகளாவிய ஷார்ட்கட்டையும் நீங்கள் விரும்பியபடி மாற்றியமையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి గ్లోబల్ షార్ట్‌కట్‌ను మీకు నచ్చినదానికి మార్చుకోండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر گلوبل شارٹ کٹ کو اپنی پسند کے مطابق دوبارہ مقرر کریں۔"
          }
        }
      }
    },
