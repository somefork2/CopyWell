    "Put the item copied before the current one back on the clipboard": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة العنصر المنسوخ قبل العنصر الحالي إلى الحافظة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a posar al porta-retalls l’element copiat abans de l’actual"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátit do schránky položku zkopírovanou před tou aktuální"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg emnet, der blev kopieret før det nuværende, tilbage på udklipsholderen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den vor dem aktuellen kopierten Eintrag wieder in die Zwischenablage legen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφορά στο πρόχειρο του στοιχείου που αντιγράφηκε πριν από το τρέχον"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a poner en el portapapeles el elemento copiado antes del actual"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauta leikepöydälle nykyistä edeltävä kopioitu kohde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remettre dans le presse-papiers l’élément copié avant l’actuel"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזרת הפריט שהועתק לפני הנוכחי ללוח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा आइटम से पहले कॉपी किया गया आइटम वापस क्लिपबोर्ड पर रखें"
          }
        },
        "hr": {
