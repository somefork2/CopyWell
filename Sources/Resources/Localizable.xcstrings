            "value": "Использовать цвет, под который создана тема"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použiť farbu, okolo ktorej je motív postavený"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd färgen temat är byggt kring"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สีที่ธีมนี้ออกแบบมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu temanın tasarlandığı rengi kullan"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використати колір, під який створено тему"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng màu mà giao diện này được thiết kế quanh nó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用该主题原本的配色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用該主題原本的配色"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই থিমটি যে রংকে ঘিরে তৈরি, সেটি ব্যবহার করুন"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ થીમ જે રંગની આસપાસ બનાવવામાં આવી છે તે વાપરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಥೀಮ್ ಅನ್ನು ವಿನ್ಯಾಸಗೊಳಿಸಿದ ಬಣ್ಣವನ್ನೇ ಬಳಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ തീം രൂപകൽപ്പന ചെയ്ത നിറം തന്നെ ഉപയോഗിക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही थीम ज्या रंगाभोवती डिझाइन केली आहे तो रंग वापरा"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଥିମ୍ ଯେଉଁ ରଙ୍ଗକୁ ଆଧାର କରି ଡିଜାଇନ୍ କରାଯାଇଛି, ତାହା ବ୍ୟବହାର କରନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਰੰਗ ਵਰਤੋ ਜਿਸਨੂੰ ਧਿਆਨ ਵਿੱਚ ਰੱਖ ਕੇ ਇਹ ਥੀਮ ਬਣਾਈ ਗਈ ਸੀ"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi barvo, okoli katere je bila ta tema zasnovana"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தீம் வடிவமைக்கப்பட்ட வண்ணத்தைப் பயன்படுத்து"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ థీమ్‌ను రూపొందించిన ప్రధాన రంగును ఉపయోగించు"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ رنگ استعمال کریں جس کے گرد یہ تھیم ڈیزائن کی گئی تھی"
          }
        }
      }
    },
