          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøveperioden din på 30 dager er over. Abonner for å fortsette å bruke CopyWell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode van 30 dagen is voorbij. Neem een abonnement om CopyWell te blijven gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój 30-dniowy okres próbny dobiegł końca. Wykup subskrypcję, aby korzystać dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste de 30 dias terminou. Assine para continuar usando o CopyWell."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu período experimental de 30 dias terminou. Subscreva para continuar a usar o CopyWell."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perioada dvs. de probă de 30 de zile s-a încheiat. Abonați-vă pentru a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш 30-дневный пробный период закончился. Оформите подписку, чтобы продолжить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša 30-dňová skúšobná doba sa skončila. Na ďalšie používanie si predplaťte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din provperiod på 30 dagar är slut. Prenumerera för att fortsätta använda CopyWell."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทดลองใช้ 30 วันของคุณสิ้นสุดแล้ว สมัครสมาชิกเพื่อใช้งานต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 günlük deneme süreniz bitti. Kullanmaya devam etmek için abone olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш 30-денний пробний період завершився. Оформіть передплату, щоб продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian dùng thử 30 ngày của bạn đã kết thúc. Hãy đăng ký để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 30 天试用已结束。订阅后可继续使用 CopyWell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 30 天試用已結束。訂閱後可繼續使用 CopyWell。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ৩০ দিনের ট্রায়াল শেষ হয়েছে। CopyWell ব্যবহার চালিয়ে যেতে সাবস্ক্রাইব করুন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી 30-દિવસની ટ્રાયલ પૂરી થઈ ગઈ છે. CopyWell વાપરવાનું ચાલુ રાખવા સબ્સ્ક્રાઇબ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ 30-ದಿನಗಳ ಪ್ರಾಯೋಗಿಕ ಅವಧಿ ಮುಗಿದಿದೆ. CopyWell ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಲು ಚಂದಾದಾರರಾಗಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ 30 ദിവസത്തെ ട്രയൽ അവസാനിച്ചു. CopyWell ഉപയോഗം തുടരാൻ സബ്സ്ക്രൈബ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची 30 दिवसांची चाचणी संपली आहे. CopyWell वापरत राहण्यासाठी सदस्यता घ्या."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ 30 ଦିନିଆ ଟ୍ରାଏଲ୍ ଶେଷ ହୋଇଛି। CopyWell ବ୍ୟବହାର ଜାରି ରଖିବାକୁ ସଦସ୍ୟତା ନିଅନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ 30-ਦਿਨਾਂ ਦਾ ਟ੍ਰਾਇਲ ਖ਼ਤਮ ਹੋ ਗਿਆ ਹੈ। CopyWell ਵਰਤਦੇ ਰਹਿਣ ਲਈ ਸਬਸਕ੍ਰਾਈਬ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše 30-dnevno preizkusno obdobje se je izteklo. Naročite se, če želite še naprej uporabljati CopyWell."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
