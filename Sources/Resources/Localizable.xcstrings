          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把佇列中的下一項放到剪貼板"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারির পরের আইটেমটি ক্লিপবোর্ডে রাখুন"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કતારમાંની આગળની આઇટમ ક્લિપબોર્ડ પર મૂકો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರದಿಯಲ್ಲಿರುವ ಮುಂದಿನ ಐಟಂ ಅನ್ನು ಕ್ಲಿಪ್‌ಬೋರ್ಡ್‌ಗೆ ಹಾಕಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിരയിലെ അടുത്ത ഇനം ക്ലിപ്പ്ബോർഡിലേക്ക് വയ്ക്കുക"
