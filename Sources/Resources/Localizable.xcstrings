        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സെൻസിറ്റീവ് ക്ലിപ്പുകൾ ഒരിക്കലും എക്സ്പോർട്ടുകളിൽ ഉൾപ്പെടുത്തില്ല."
