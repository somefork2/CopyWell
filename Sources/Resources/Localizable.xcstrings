        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập iCloud trong Cài đặt hệ thống để dùng đồng bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中登录 iCloud 以使用同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中登入 iCloud 以使用同步。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিঙ্ক ব্যবহার করতে সিস্টেম সেটিংসে iCloud-এ সাইন ইন করুন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિંક વાપરવા માટે સિસ્ટમ સેટિંગ્સમાં iCloudમાં સાઇન ઇન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಂಕ್ ಬಳಸಲು ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ iCloud ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിങ്ക് ഉപയോഗിക്കാൻ സിസ്റ്റം ക്രമീകരണത്തിൽ iCloud-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक वापरण्यासाठी सिस्टम सेटिंग्जमध्ये iCloud मध्ये साइन इन करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସିଙ୍କ୍ ବ୍ୟବହାର କରିବାକୁ ସିଷ୍ଟମ୍ ସେଟିଂସରେ iCloud ରେ ସାଇନ୍ ଇନ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿੰਕ ਵਰਤਣ ਲਈ System Settings ਵਿੱਚ iCloud ’ਤੇ ਸਾਈਨ ਇਨ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uporabo sinhronizacije se prijavite v iCloud v Sistemskih nastavitvah."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒத்திசைவைப் பயன்படுத்த, சிஸ்டம் அமைப்புகளில் iCloud-இல் உள்நுழையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సింక్‌ను ఉపయోగించడానికి సిస్టమ్ సెట్టింగ్‌లలో iCloudకు సైన్ ఇన్ చేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنک استعمال کرنے کے لیے سسٹم سیٹنگز میں iCloud میں سائن ان کریں۔"
          }
        }
      }
    },
