    "Clipboard history is unavailable on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الحافظة غير متوفر على هذا الـ Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historial del porta-retalls no està disponible en aquest Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie schránky na tomto Macu není k dispozici."
          }
        },
        "da": {
