        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกพื้นที่หรือทั้งหน้าจอ กดอีกครั้งเพื่อหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alanı ya da tüm ekranı kaydet; durdurmak için yeniden bas"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записати область або весь екран; натисніть ще раз, щоб зупинити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi một vùng hoặc toàn màn hình; nhấn lần nữa để dừng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制某个区域或整个屏幕；再按一次停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製某個區域或整個螢幕；再按一次即可停止"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি এলাকা বা পুরো স্ক্রিন রেকর্ড করুন; থামাতে আবার চাপুন"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિસ્તાર અથવા આખી સ્ક્રીન રેકોર્ડ કરો; બંધ કરવા ફરી દબાવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಪ್ರದೇಶ ಅಥವಾ ಸಂಪೂರ್ಣ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡ್ ಮಾಡಿ; ನಿಲ್ಲಿಸಲು ಮತ್ತೆ ಒತ್ತಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഭാഗമോ മുഴുവൻ സ്ക്രീനോ റെക്കോർഡ് ചെയ്യുക; നിർത്താൻ വീണ്ടും അമർത്തുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखादे क्षेत्र किंवा संपूर्ण स्क्रीन रेकॉर्ड करा; थांबवण्यासाठी पुन्हा दाबा"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଅଞ୍ଚଳ କିମ୍ବା ସମଗ୍ର ସ୍କ୍ରିନ୍ ରେକର୍ଡ କରନ୍ତୁ; ବନ୍ଦ କରିବାକୁ ପୁଣି ଦବାନ୍ତୁ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਖੇਤਰ ਜਾਂ ਪੂਰੀ ਸਕ੍ਰੀਨ ਰਿਕਾਰਡ ਕਰੋ; ਰੋਕਣ ਲਈ ਦੁਬਾਰਾ ਦਬਾਓ"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posnemite območje ali cel zaslon; za ustavitev znova pritisnite"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பகுதியையோ முழுத் திரையையோ பதிவு செய்; நிறுத்த மீண்டும் அழுத்து"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ప్రాంతాన్ని లేదా మొత్తం స్క్రీన్‌ను రికార్డ్ చేయి; ఆపడానికి మళ్లీ నొక్కు"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی حصہ یا پوری اسکرین ریکارڈ کریں؛ روکنے کے لیے دوبارہ دبائیں"
          }
        }
      }
    },
