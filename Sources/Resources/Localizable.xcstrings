    "Organise clips into as many boards as you need.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظّم العناصر في أي عدد تحتاجه من اللوحات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Organitza els elements en tants taulers com necessitis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspořádejte položky na tolik nástěnek, kolik potřebujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiser emner på lige så mange opslagstavler, du har brug for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne Einträge auf so vielen Pinnwänden, wie du brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οργανώστε τα στοιχεία σε όσους πίνακες χρειάζεστε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organise clips into as many boards as you need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza los elementos en tantos tableros como necesites."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä kohteet niin monelle taululle kuin tarvitset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classez vos éléments sur autant de tableaux que nécessaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדרו פריטים בכמה לוחות שתצטרכו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जितने बोर्ड चाहिए उतनों में अपनी चीज़ें सहेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasporedite stavke na onoliko ploča koliko trebate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendezze az elemeket annyi táblára, amennyire szüksége van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata item ke sebanyak papan yang Anda perlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizza gli elementi su tutte le bacheche che ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なだけボードを作って項目を整理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 만큼 보드를 만들어 항목을 정리하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun item ke seberapa banyak papan yang anda perlukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiser objekter på så mange oppslagstavler du trenger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden items op zoveel prikborden als je nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządkuj wpisy na tylu tablicach, ile potrzebujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize os itens em quantos quadros precisar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize os itens em tantos quadros quantos precisar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizați elementele pe câte panouri aveți nevoie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладывайте записи по стольким доскам, сколько нужно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Usporiadajte položky na toľko nasteniek, koľko potrebujete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordna objekt på så många anslagstavlor du behöver."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดรายการลงบอร์ดได้มากเท่าที่คุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğelerinizi ihtiyacınız kadar panoda düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкладайте записи на стількох дошках, скільки потрібно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp các mục vào bao nhiêu bảng tuỳ bạn cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想要多少块板，就用多少块来整理条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想要幾個看板，就用幾個來整理項目。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যত খুশি বোর্ডে ক্লিপ সাজিয়ে রাখুন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જરૂર હોય તેટલાં બોર્ડમાં ક્લિપ ગોઠવો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮಗೆ ಬೇಕಾದಷ್ಟು ಬೋರ್ಡ್‌ಗಳಲ್ಲಿ ಕ್ಲಿಪ್‌ಗಳನ್ನು ಸಂಘಟಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾക്കാവശ്യമുള്ളത്ര ബോർഡുകളിലായി ക്ലിപ്പുകൾ ക്രമീകരിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला हवे तितके बोर्ड्स बनवून क्लिप्स व्यवस्थित ठेवा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯେତେ ଆବଶ୍ୟକ ସେତେ ବୋର୍ଡରେ କ୍ଲିପ୍ ସଜାଡ଼ନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਲਿੱਪਾਂ ਨੂੰ ਜਿੰਨੇ ਚਾਹੋ ਬੋਰਡਾਂ ਵਿੱਚ ਵਿਵਸਥਿਤ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razvrstite vnose na poljubno število tabel."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேவையான அளவு போர்டுகளில் கிளிப்களை ஒழுங்கமையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు అవసరమైనన్ని బోర్డ్‌లలో క్లిప్‌లను ఆర్గనైజ్ చేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلپس کو جتنے چاہیں بورڈز میں ترتیب دیں۔"
          }
        }
      }
    },
