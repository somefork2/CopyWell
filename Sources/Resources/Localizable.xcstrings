            "value": "احتفظ بالعناصر التي تعيد استخدامها، أو رتّب عدة عناصر والصقها بالترتيب."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva els elements que reutilitzes, o posa’n uns quants en cua i enganxa’ls en ordre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte si položky, které používáte opakovaně, nebo jich několik zařaďte za sebe a vložte je po pořadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem de emner, du bruger igen, eller sæt flere i kø og indsæt dem i rækkefølge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre Einträge auf, die du wieder brauchst, oder reihe mehrere auf und füge sie der Reihe nach ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τα στοιχεία που ξαναχρησιμοποιείτε ή βάλτε πολλά στη σειρά και επικολλήστε τα με τη σειρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep clips you reuse, or queue several and paste them in order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lo que reutilizas, o pon varios elementos en cola y pégalos en orden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä kohteet, joita käytät uudelleen, tai laita useampi jonoon ja liitä ne järjestyksessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez ce que vous réutilisez, ou mettez plusieurs éléments en file et collez-les dans l’ordre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו פריטים שאתם משתמשים בהם שוב, או סדרו כמה בתור והדביקו אותם לפי הסדר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो चीज़ें दोबारा काम आती हैं उन्हें रखें, या कई को क़तार में लगाकर क्रम से पेस्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržite stavke koje ponovno koristite ili poredajte nekoliko njih i zalijepite ih redom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa meg az újra használt elemeket, vagy állítson sorba többet, és illessze be őket egymás után."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan item yang sering Anda pakai lagi, atau antrekan beberapa lalu tempel berurutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni gli elementi che riusi, oppure mettine diversi in coda e incollali in ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う項目を取っておいたり、複数を並べて順にペーストしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 항목을 남겨 두거나, 여러 개를 모아 순서대로 붙여넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan item yang anda guna semula, atau bariskan beberapa dan tampal mengikut urutan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vare på objekter du bruker igjen, eller sett flere i kø og lim dem inn etter tur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar items die je opnieuw gebruikt, of zet er een paar op rij en plak ze op volgorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuj wpisy, z których korzystasz ponownie, albo ustaw kilka w kolejce i wklej po kolei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o que você reutiliza, ou enfileire vários e cole na ordem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde os itens que reutiliza, ou ponha vários em fila e cole-os por ordem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați elementele pe care le refolosiți sau puneți mai multe la rând și lipiți-le în ordine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте записи, которыми пользуетесь снова, или соберите несколько и вставьте по очереди."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte si položky, ktoré používate opakovane, alebo ich niekoľko zaraďte za sebou a vložte ich po poradí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara objekt du återanvänder, eller ställ flera i kö och klistra in dem i tur och ordning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บรายการที่คุณใช้ซ้ำ หรือจัดคิวหลายรายการแล้ววางตามลำดับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar kullandığınız öğeleri saklayın ya da birkaçını sıraya dizip sırayla yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте записи, якими користуєтеся повторно, або зберіть кілька й вставте по черзі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lại những mục bạn dùng lại, hoặc xếp vài mục rồi dán theo thứ tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留下常用的条目，或把几项排好队，按顺序粘贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留下常用的項目，或把幾項排好，依序貼上。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বারবার ব্যবহার করা ক্লিপ রেখে দিন, অথবা কয়েকটি সারিতে রেখে ক্রমানুসারে পেস্ট করুন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફરી વાપરતા હો તે ક્લિપ રાખો, અથવા ઘણી ક્લિપ કતારમાં મૂકીને ક્રમમાં પેસ્ટ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮರುಬಳಸುವ ಕ್ಲಿಪ್‌ಗಳನ್ನು ಇಟ್ಟುಕೊಳ್ಳಿ, ಅಥವಾ ಹಲವನ್ನು ಸರದಿಯಲ್ಲಿಟ್ಟು ಕ್ರಮವಾಗಿ ಅಂಟಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീണ്ടും ഉപയോഗിക്കുന്ന ക്ലിപ്പുകൾ സൂക്ഷിക്കുക, അല്ലെങ്കിൽ പലതും നിരയിലാക്കി ക്രമത്തിൽ ഒട്ടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुन्हा वापरत असलेल्या क्लिप्स जपून ठेवा, किंवा अनेक क्लिप्स रांगेत लावून क्रमाने पेस्ट करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପୁଣି ବ୍ୟବହାର କରୁଥିବା କ୍ଲିପ୍ ରଖନ୍ତୁ, କିମ୍ବା ଅନେକଗୁଡ଼ିକୁ ଧାଡ଼ିରେ ରଖି କ୍ରମରେ ପେଷ୍ଟ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਿਹੜੀਆਂ ਕਲਿੱਪਾਂ ਤੁਸੀਂ ਮੁੜ-ਮੁੜ ਵਰਤਦੇ ਹੋ ਉਨ੍ਹਾਂ ਨੂੰ ਰੱਖੋ, ਜਾਂ ਕਈਆਂ ਨੂੰ ਕਤਾਰ ਵਿੱਚ ਲਗਾ ਕੇ ਕ੍ਰਮਵਾਰ ਪੇਸਟ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranite vnose, ki jih pogosto uporabljate, ali jih več postavite v vrsto in prilepite po vrsti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் பயன்படுத்தும் கிளிப்களை வைத்திருங்கள், அல்லது பலவற்றை வரிசையில் சேர்த்து ஒன்றன்பின் ஒன்றாக ஒட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మళ్లీ ఉపయోగించే క్లిప్‌లను ఉంచుకోండి, లేదా అనేకాన్ని క్యూలో పెట్టి వరుసగా పేస్ట్ చేయండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ استعمال ہونے والے کلپس محفوظ رکھیں، یا کئی کلپس قطار میں لگا کر ترتیب سے پیسٹ کریں۔"
          }
        }
      }
    },
