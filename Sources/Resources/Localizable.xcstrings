            "value": "Súbor uložený pre tento obrázok sa nepodarilo načítať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen som sparats för den här bilden kunde inte läsas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านไฟล์ที่เก็บไว้สำหรับรูปภาพนี้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görüntü için saklanan dosya okunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати файл, збережений для цього зображення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được tệp đã lưu cho hình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此图像所存储的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此影像所儲存的檔案。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ছবির সংরক্ষিত ফাইলটি পড়া যায়নি।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ છબીની સંગ્રહિત ફાઇલ વાંચી શકાઈ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಚಿತ್ರದ ಸಂಗ್ರಹಿಸಿದ ಫೈಲ್ ಅನ್ನು ಓದಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ചിത്രത്തിനായി സംഭരിച്ച ഫയൽ വായിക്കാൻ കഴിഞ്ഞില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या इमेजची साठवलेली फाइल वाचता आली नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଛବିର ସଂରକ୍ଷିତ ଫାଇଲ୍ ପଢ଼ିହେଲା ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਤਸਵੀਰ ਲਈ ਸਟੋਰ ਕੀਤੀ ਫ਼ਾਈਲ ਪੜ੍ਹੀ ਨਹੀਂ ਜਾ ਸਕੀ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjene datoteke za to sliko ni bilo mogoče prebrati."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் படத்திற்காகச் சேமிக்கப்பட்ட கோப்பைப் படிக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చిత్రం కోసం నిల్వ చేసిన ఫైల్‌ను చదవలేకపోయాము."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس تصویر کی محفوظ فائل پڑھی نہیں جا سکی۔"
          }
        }
      }
    },
