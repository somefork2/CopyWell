          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavi naslednji vnos iz vrste v odložišče"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரிசையில் உள்ள அடுத்த உருப்படியைக் கிளிப்போர்டில் வை"
          }
