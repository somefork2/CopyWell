          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 테마가 본래 사용하는 색상 쓰기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan warna asal tema ini"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk fargen temaet er bygd rundt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de kleur waarvoor dit thema is ontworpen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj koloru, wokół którego zbudowano ten motyw"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar a cor para a qual este tema foi criado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar a cor para a qual este tema foi pensado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește culoarea în jurul căreia a fost gândită tema"
          }
        },
        "ru": {
          "stringUnit": {
