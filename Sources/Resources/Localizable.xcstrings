          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita useampi kohde jonoon ja liitä ne peräkkäin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez plusieurs éléments en file et collez-les l’un après l’autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדרו כמה פריטים בתור והדביקו אותם בזה אחר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई चीज़ों को क़तार में लगाएँ और एक के बाद एक पेस्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poredajte nekoliko stavki i lijepite ih jednu za drugom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítson sorba több elemet, és illessze be őket egymás után."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrekan beberapa item lalu tempel satu per satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in coda più elementi e incollali uno dopo l’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の項目を並べて、順番にペーストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 항목을 모아 차례대로 붙여넣으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bariskan beberapa item dan tampal satu demi satu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett flere objekter i kø, og lim dem inn etter hverandre."
          }
