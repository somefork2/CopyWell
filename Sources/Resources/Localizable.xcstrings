          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসেই করা বিশ্লেষণ ক্লিপগুলোকে ধরন, ভাষা ও এনটিটি অনুযায়ী ট্যাগ করে।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડિવાઇસ પર જ થતું વિશ્લેષણ ક્લિપને પ્રકાર, ભાષા અને એન્ટિટી પ્રમાણે ટૅગ કરે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಧನದಲ್ಲೇ ನಡೆಯುವ ವಿಶ್ಲೇಷಣೆಯು ಕ್ಲಿಪ್‌ಗಳನ್ನು ಪ್ರಕಾರ, ಭಾಷೆ ಮತ್ತು ಘಟಕಗಳ ಅನುಸಾರ ಟ್ಯಾಗ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപകരണത്തിൽ തന്നെയുള്ള വിശകലനം ക്ലിപ്പുകളെ തരം, ഭാഷ, എന്റിറ്റികൾ എന്നിവ അനുസരിച്ച് ടാഗ് ചെയ്യുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिव्हाइसवरच होणारे विश्लेषण क्लिप्सना प्रकार, भाषा आणि घटकांनुसार टॅग करते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଡିଭାଇସରେ ହିଁ ହେଉଥିବା ବିଶ୍ଳେଷଣ କ୍ଲିପକୁ ପ୍ରକାର, ଭାଷା ଏବଂ ସତ୍ତା ଅନୁସାରେ ଟ୍ୟାଗ୍ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡਿਵਾਈਸ ’ਤੇ ਹੀ ਹੋਣ ਵਾਲਾ ਵਿਸ਼ਲੇਸ਼ਣ ਕਲਿੱਪਾਂ ਨੂੰ ਕਿਸਮ, ਭਾਸ਼ਾ ਅਤੇ ਇਕਾਈਆਂ ਅਨੁਸਾਰ ਟੈਗ ਕਰਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza v napravi označi vnose po vrsti, jeziku in entitetah."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதனத்திலேயே நடக்கும் பகுப்பாய்வு, கிளிப்களை வகை, மொழி, உள்ளடக்கக் கூறுகள் அடிப்படையில் குறியிடுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డివైజ్‌లోనే జరిగే విశ్లేషణ క్లిప్‌లను రకం, భాష, ఎంటిటీల ఆధారంగా ట్యాగ్ చేస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن ڈیوائس تجزیہ کلپس کو قسم، زبان اور ان میں موجود عناصر کے لحاظ سے ٹیگ کرتا ہے۔"
          }
        }
      }
    },
    "Once there are more than %@ clips, the oldest are removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يتجاوز العدد %@ عنصراً، تُحذف الأقدم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan hi hagi més de %@ elements, se n’eliminen els més antics."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile je položek více než %@, nejstarší se odstraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når der er mere end %@ klip, fjernes de ældste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald es mehr als %@ Einträge gibt, werden die ältesten entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν υπάρχουν περισσότερα από %@ αντικείμενα, τα παλαιότερα αφαιρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once there are more than %@ clips, the oldest are removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hay más de %@ elementos, se eliminan los más antiguos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun leikkeitä on yli %@, vanhimmat poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-delà de %@ éléments, les plus anciens sont supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשיש יותר מ‑%@ פריטים, הישנים ביותר נמחקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से ज़्यादा आइटम होने पर सबसे पुराने हटा दिए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad bude više od %@ stavki, najstarije se uklanjaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha több mint %@ elem van, a legrégebbiek törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika lebih dari %@ item, yang terlama dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ci sono più di %@ elementi, i più vecchi vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@件を超えると、古いものから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개를 넘으면 오래된 것부터 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila melebihi %@ item, yang terlama dibuang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er mer enn %@ klipp, fjernes de eldste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra er meer dan %@ items zijn, worden de oudste verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy elementów jest więcej niż %@, najstarsze są usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando houver mais de %@ itens, os mais antigos são removidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando houver mais de %@ itens, os mais antigos são removidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când sunt mai mult de %@ elemente, cele mai vechi sunt șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда записей становится больше %@, самые старые удаляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je položiek viac ako %@, najstaršie sa odstránia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det finns fler än %@ klipp tas de äldsta bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีมากกว่า %@ รายการ รายการเก่าสุดจะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ögeden fazla olduğunda en eskiler silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли записів стає більше %@, найстаріші видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có hơn %@ mục, những mục cũ nhất sẽ bị xoá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 %@ 条后，最早的会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過 %@ 筆後，最早的會被刪除。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@টির বেশি ক্লিপ হলে সবচেয়ে পুরোনোগুলো সরিয়ে ফেলা হয়।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ કરતાં વધુ ક્લિપ થાય ત્યારે સૌથી જૂની ક્લિપ દૂર કરવામાં આવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಕ್ಕಿಂತ ಹೆಚ್ಚು ಕ್ಲಿಪ್‌ಗಳಾದಾಗ, ಅತ್ಯಂತ ಹಳೆಯವುಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലിപ്പുകൾ %@-ൽ കൂടുതലാകുമ്പോൾ, ഏറ്റവും പഴയവ നീക്കം ചെയ്യപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पेक्षा जास्त क्लिप्स झाल्यावर सर्वात जुन्या क्लिप्स काढून टाकल्या जातात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ରୁ ଅଧିକ କ୍ଲିପ୍ ହେଲେ, ସବୁଠାରୁ ପୁରୁଣାଗୁଡ଼ିକ କାଢ଼ି ଦିଆଯାଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ %@ ਤੋਂ ਵੱਧ ਕਲਿੱਪਾਂ ਹੋ ਜਾਣ, ਤਾਂ ਸਭ ਤੋਂ ਪੁਰਾਣੀਆਂ ਹਟਾ ਦਿੱਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je vnosov več kot %@, se najstarejši odstranijo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ கிளிப்களுக்கு மேல் ஆனதும், பழையவை அகற்றப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కంటే ఎక్కువ క్లిప్‌లు అయినప్పుడు, పాతవి తీసివేయబడతాయి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کلپس کی تعداد %@ سے زیادہ ہو جائے تو سب سے پرانے ہٹا دیے جاتے ہیں۔"
          }
        }
      }
    },
