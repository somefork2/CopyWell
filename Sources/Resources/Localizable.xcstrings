        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ไม่เคยกดแป้นแทนคุณ จึงไม่ต้องขอสิทธิ์การช่วยการเข้าถึง หากต้องการแทรกรายการโดยไม่กด ⌘V ให้ใช้ บริการ ▸ วางจาก CopyWell"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell sizin yerinize tuşlara basmaz, bu yüzden Erişilebilirlik iznine gerek duymaz. ⌘V’ye basmadan öğe eklemek için Hizmetler ▸ CopyWell’den yapıştır seçeneğini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell не натискає клавіші замість вас, тому доступ до Доступності не потрібен. Щоб вставити запис без ⌘V, скористайтеся Служби ▸ Вставити з CopyWell."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell không bao giờ bấm phím thay bạn, nên không cần quyền Trợ năng. Để chèn một mục mà không nhấn ⌘V, hãy dùng Dịch vụ ▸ Dán từ CopyWell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 从不替你按键，因此无需辅助功能权限。若想不按 ⌘V 就插入条目，请用「服务 ▸ 从 CopyWell 粘贴」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell 從不替你按鍵，因此不需要輔助使用權限。若想不按 ⌘V 就插入項目，請用「服務 ▸ 從 CopyWell 貼上」。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell কখনো আপনার হয়ে কী চাপে না, তাই এর অ্যাক্সেসিবিলিটি অ্যাক্সেসের দরকার নেই। ⌘V না চেপে কোনো ক্লিপ বসাতে পরিষেবা ▸ “CopyWell থেকে পেস্ট করুন” ব্যবহার করুন।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ક્યારેય તમારા વતી કી દબાવતું નથી, તેથી તેને ઍક્સેસિબિલિટી ઍક્સેસની જરૂર નથી. ⌘V દબાવ્યા વિના ક્લિપ દાખલ કરવા માટે, સેવાઓ ▸ “CopyWellમાંથી પેસ્ટ કરો” વાપરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ನಿಮ್ಮ ಪರವಾಗಿ ಎಂದಿಗೂ ಕೀಗಳನ್ನು ಒತ್ತುವುದಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದಕ್ಕೆ ಪ್ರವೇಶಿಸುವಿಕೆ ಅನುಮತಿ ಬೇಕಿಲ್ಲ. ⌘V ಒತ್ತದೆಯೇ ಕ್ಲಿಪ್ ಸೇರಿಸಲು, ಸೇವೆಗಳು ▸ CopyWell ನಿಂದ ಅಂಟಿಸಿ ಬಳಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ഒരിക്കലും നിങ്ങൾക്കുവേണ്ടി കീകൾ അമർത്തുന്നില്ല, അതിനാൽ അതിന് പ്രവേശനക്ഷമത ആക്സസ് ആവശ്യമില്ല. ⌘V അമർത്താതെ ഒരു ക്ലിപ്പ് ചേർക്കാൻ, സേവനങ്ങൾ ▸ CopyWell-ൽ നിന്ന് ഒട്ടിക്കുക ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell तुमच्यासाठी कधीही कीज दाबत नाही, त्यामुळे त्याला ॲक्सेसिबिलिटी परवानगीची गरज नाही. ⌘V न दाबता क्लिप घालण्यासाठी सेवा ▸ “CopyWell मधून पेस्ट करा” वापरा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ଆପଣଙ୍କ ପାଇଁ କେବେ ବି କି ଦବାଏ ନାହିଁ, ତେଣୁ ଏହାର ଆକ୍ସେସିବିଲିଟି ଅନୁମତିର ଆବଶ୍ୟକତା ନାହିଁ। ⌘V ନ ଦବାଇ ଏକ କ୍ଲିପ୍ ଭର୍ତ୍ତି କରିବାକୁ ସେବା ▸ “CopyWell ରୁ ପେଷ୍ଟ କରନ୍ତୁ” ବ୍ୟବହାର କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell ਕਦੇ ਵੀ ਤੁਹਾਡੇ ਲਈ ਕੁੰਜੀਆਂ ਨਹੀਂ ਦਬਾਉਂਦਾ, ਇਸ ਲਈ ਇਸਨੂੰ ਪਹੁੰਚਯੋਗਤਾ (Accessibility) ਇਜਾਜ਼ਤ ਦੀ ਲੋੜ ਨਹੀਂ ਹੈ। ⌘V ਦਬਾਏ ਬਿਨਾਂ ਕਲਿੱਪ ਪਾਉਣ ਲਈ, Services ▸ CopyWell ਤੋਂ ਪੇਸਟ ਕਰੋ ਵਰਤੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell nikoli ne pritiska tipk namesto vas, zato ne potrebuje dovoljenja za dostopnost. Če želite vstaviti vnos brez pritiska ⌘V, uporabite Storitve ▸ Prilepi iz CopyWella."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell உங்களுக்காக ஒருபோதும் விசைகளை அழுத்தாது, எனவே அதற்கு அணுகல்தன்மை அனுமதி தேவையில்லை. ⌘V அழுத்தாமல் ஒரு கிளிப்பைச் செருக, சேவைகள் ▸ CopyWell-இலிருந்து ஒட்டு என்பதைப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell మీ తరపున ఎప్పుడూ కీలను నొక్కదు, కాబట్టి దానికి యాక్సెసిబిలిటీ యాక్సెస్ అవసరం లేదు. ⌘V నొక్కకుండా ఒక క్లిప్‌ను చొప్పించడానికి, సేవలు ▸ CopyWell నుండి పేస్ట్ చేయి ఉపయోగించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell آپ کی جگہ کبھی کلیدیں نہیں دباتا، اس لیے اسے رسائی پذیری کی اجازت درکار نہیں۔ ⌘V دبائے بغیر کوئی کلپ داخل کرنے کے لیے سروسز ◂ “CopyWell سے پیسٹ کریں” استعمال کریں۔"
          }
        }
      }
    },
    "CopyWell only records while it is running. More themes, accent colours and text size are in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell записывает только пока запущен. Другие темы, акцентные цвета и размер текста — в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell записує, лише доки працює. Інші теми, акцентні кольори та розмір тексту — у налаштуваннях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell zeichnet nur auf, solange es läuft. Weitere Themes, Akzentfarben und die Textgröße finden sich in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell n’enregistre que lorsqu’il est ouvert. D’autres thèmes, couleurs d’accentuation et tailles de texte se trouvent dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell solo graba mientras está en marcha. Hay más temas, colores de acento y tamaños de texto en los ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CopyWell registra solo mentre è in esecuzione. Altri temi, colori d’accento e dimensioni del testo sono nelle impostazioni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O CopyWell só grava enquanto está a correr. Há mais temas, cores de destaque e tamanhos de texto nas definições."
          }
        },
        "pt-BR": {
          "stringUnit": {
