{
  "sourceLanguage": "en",
  "strings": {
    " The %@ trial converts to a paid subscription unless cancelled at least 24 hours before it ends.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " تتحول الفترة التجريبية %@ إلى اشتراك مدفوع ما لم تُلغَ قبل انتهائها بـ 24 ساعة على الأقل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": " La prova de %@ passa a ser una subscripció de pagament si no la canceles com a mínim 24 hores abans que acabi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " Zkušební období %@ se změní na placené předplatné, pokud ho nezrušíte alespoň 24 hodin před koncem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": " Prøveperioden på %@ bliver til et betalt abonnement, medmindre du opsiger senest 24 timer før den slutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Testphase von %@ geht in ein kostenpflichtiges Abo über, sofern sie nicht mindestens 24 Stunden vor Ende gekündigt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": " Η δοκιμή %@ μετατρέπεται σε συνδρομή επί πληρωμή, εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν λήξει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The %@ trial converts to a paid subscription unless cancelled at least 24 hours before it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " La prueba de %@ pasa a ser una suscripción de pago si no se cancela al menos 24 horas antes de que termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ kokeilu muuttuu maksulliseksi tilaukseksi, ellei sitä peruuteta vähintään 24 tuntia ennen päättymistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " L’essai de %@ devient un abonnement payant s’il n’est pas résilié au moins 24 heures avant son terme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " תקופת הניסיון של %@ הופכת למינוי בתשלום אלא אם תבוטל לפחות 24 שעות לפני סיומה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ का ट्रायल समाप्त होने से कम से कम 24 घंटे पहले रद्द न करने पर सशुल्क सदस्यता में बदल जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": " Probno razdoblje od %@ prelazi u plaćenu pretplatu ako se ne otkaže najmanje 24 sata prije isteka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": " A(z) %@ próbaidőszak fizetős előfizetéssé alakul, ha nem mondja le legalább 24 órával a vége előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " Uji coba %@ berubah menjadi langganan berbayar kecuali dibatalkan minimal 24 jam sebelum berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " La prova di %@ diventa un abbonamento a pagamento se non viene annullata almeno 24 ore prima della scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " %@の体験期間は、終了の24時間前までに解約しない限り有料サブスクリプションに移行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 체험 기간은 종료 24시간 전까지 취소하지 않으면 유료 구독으로 전환됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": " Percubaan %@ bertukar kepada langganan berbayar melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": " Prøveperioden på %@ går over til et betalt abonnement hvis den ikke sies opp minst 24 timer før den utløper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " De proefperiode van %@ gaat over in een betaald abonnement tenzij je minstens 24 uur voor het einde opzegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Okres próbny %@ zamienia się w płatną subskrypcję, jeśli nie zostanie anulowany co najmniej 24 godziny przed końcem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " O teste de %@ vira uma assinatura paga se não for cancelado pelo menos 24 horas antes de terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": " O período experimental de %@ passa a subscrição paga se não for cancelado pelo menos 24 horas antes de terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": " Perioada de probă de %@ devine abonament cu plată dacă nu este anulată cu cel puțin 24 de ore înainte de expirare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Пробный период %@ превращается в платную подписку, если не отменить его не позже чем за 24 часа до окончания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": " Skúšobné obdobie %@ sa zmení na platené predplatné, ak ho nezrušíte aspoň 24 hodín pred koncom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": " Testperioden på %@ övergår till en betald prenumeration om den inte sägs upp minst 24 timmar innan den tar slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " ช่วงทดลองใช้ %@ จะเปลี่ยนเป็นการสมัครแบบเสียเงิน หากไม่ยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ deneme süresi, bitiminden en az 24 saat önce iptal edilmezse ücretli aboneliğe dönüşür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " Пробний період %@ перетворюється на платну передплату, якщо не скасувати його щонайменше за 24 години до завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " Bản dùng thử %@ sẽ chuyển thành gói trả phí nếu không huỷ trước khi kết thúc ít nhất 24 giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 试用期在结束前至少 24 小时未取消，将自动转为付费订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 試用期在結束前至少 24 小時未取消，將自動轉為付費訂閱。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": " ট্রায়াল (%@) শেষ হওয়ার অন্তত ২৪ ঘণ্টা আগে বাতিল না করলে এটি পেইড সাবস্ক্রিপশনে রূপান্তরিত হবে।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": " ટ્રાયલ (%@) પૂરી થાય તેના ઓછામાં ઓછા 24 કલાક પહેલાં રદ ન કરો, તો તે પેઇડ સબ્સ્ક્રિપ્શનમાં બદલાઈ જશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": " ಉಚಿತ ಪ್ರಾಯೋಗಿಕ ಅವಧಿ (%@) ಮುಗಿಯುವ ಕನಿಷ್ಠ 24 ಗಂಟೆಗಳ ಮೊದಲು ರದ್ದುಗೊಳಿಸದಿದ್ದರೆ, ಅದು ಪಾವತಿಸಿದ ಚಂದಾದಾರಿಕೆಯಾಗಿ ಬದಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": " സൗജന്യ ട്രയൽ (%@) അവസാനിക്കുന്നതിന് കുറഞ്ഞത് 24 മണിക്കൂർ മുമ്പ് റദ്ദാക്കിയില്ലെങ്കിൽ, അത് പണമടച്ചുള്ള സബ്സ്ക്രിപ്ഷനായി മാറും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ ही चाचणी संपण्याच्या किमान 24 तास आधी रद्द न केल्यास ती सशुल्क सदस्यतेत रूपांतरित होते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ ଟ୍ରାଏଲ୍ ଶେଷ ହେବାର ଅତି କମରେ 24 ଘଣ୍ଟା ପୂର୍ବରୁ ବାତିଲ୍ ନକଲେ ଏହା ଦେୟଯୁକ୍ତ ସଦସ୍ୟତାରେ ପରିଣତ ହୁଏ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": " ਮੁਫ਼ਤ ਟ੍ਰਾਇਲ (%@) ਭੁਗਤਾਨ ਵਾਲੀ ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਵਿੱਚ ਬਦਲ ਜਾਂਦਾ ਹੈ, ਜਦੋਂ ਤੱਕ ਇਸਨੂੰ ਖ਼ਤਮ ਹੋਣ ਤੋਂ ਘੱਟੋ-ਘੱਟ 24 ਘੰਟੇ ਪਹਿਲਾਂ ਰੱਦ ਨਹੀਂ ਕੀਤਾ ਜਾਂਦਾ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": " Preizkusno obdobje (%@) se samodejno spremeni v plačljivo naročnino, razen če ga prekličete vsaj 24 ur pred iztekom."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": " சோதனைக் காலம் (%@) முடிவதற்குக் குறைந்தது 24 மணிநேரத்திற்கு முன் ரத்து செய்யாவிட்டால், அது கட்டணச் சந்தாவாக மாறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": " ట్రయల్ (%@) ముగియడానికి కనీసం 24 గంటల ముందు రద్దు చేయకపోతే, అది చెల్లింపు సబ్‌స్క్రిప్షన్‌గా మారుతుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ والا ٹرائل ختم ہونے سے کم از کم 24 گھنٹے پہلے منسوخ نہ کیا جائے تو یہ بامعاوضہ سبسکرپشن میں بدل جاتا ہے۔"
          }
        }
      }
    },
    "%@ per %@, billed through your Apple Account and renewed automatically until cancelled.%@ Manage or cancel in App Store ▸ Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لكل %@، تُحصَّل عبر حساب Apple الخاص بك وتُجدَّد تلقائياً حتى الإلغاء.%@ يمكنك الإدارة أو الإلغاء من App Store ◂ الاشتراكات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@, cobrat mitjançant el teu compte d’Apple i renovat automàticament fins que el cancel·lis.%@ Gestiona’l o cancel·la’l a l’App Store ▸ Subscripcions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ za %@, účtováno přes váš účet Apple a automaticky obnovováno, dokud ho nezrušíte.%@ Spravovat nebo zrušit můžete v App Store ▸ Předplatná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pr. %@, betales via din Apple-konto og fornyes automatisk, indtil du opsiger.%@ Administrer eller opsig i App Store ▸ Abonnementer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro %@, Abrechnung über deinen Apple-Account, automatische Verlängerung bis zur Kündigung.%@ Verwalten oder kündigen im App Store ▸ Abos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ανά %@, με χρέωση μέσω του λογαριασμού Apple σας και αυτόματη ανανέωση μέχρι την ακύρωση.%@ Διαχείριση ή ακύρωση στο App Store ▸ Συνδρομές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
