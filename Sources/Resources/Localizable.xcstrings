        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động xoá các mục cũ hơn khoảng thời gian bạn chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
