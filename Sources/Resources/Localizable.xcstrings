    "A clip that looked like a password was not recorded.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ عنصر بدا كأنه كلمة سر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha desat un element que semblava una contrasenya."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položka, která vypadala jako heslo, nebyla uložena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et emne, der lignede en adgangskode, blev ikke gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Eintrag, der wie ein Passwort aussah, wurde nicht gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα στοιχείο που έμοιαζε με συνθηματικό δεν καταγράφηκε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clip that looked like a password was not recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardó un elemento que parecía una contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanalta näyttänyttä kohdetta ei tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément qui ressemblait à un mot de passe n’a pas été enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריט שנראה כמו סיסמה לא נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो चीज़ पासवर्ड जैसी लगी, उसे सहेजा नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavka koja je izgledala kao lozinka nije spremljena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy jelszónak tűnő elemet nem mentettünk el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang tampak seperti kata sandi tidak disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento che sembrava una password non è stato registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードらしき項目は記録しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호로 보이는 항목은 기록하지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item yang kelihatan seperti kata laluan tidak disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et objekt som så ut som et passord, ble ikke lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een item dat op een wachtwoord leek, is niet bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpis wyglądający na hasło nie został zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item que parecia uma senha não foi registrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item que parecia uma palavra-passe não foi guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un element care semăna cu o parolă nu a fost salvat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись, похожая на пароль, не сохранена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položka, ktorá vyzerala ako heslo, sa neuložila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett objekt som såg ut som ett lösenord sparades inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่ดูเหมือนรหัสผ่านไม่ได้ถูกบันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolaya benzeyen bir öğe kaydedilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис, схожий на пароль, не збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mục trông giống mật khẩu đã không được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一项看起来像密码，已不予记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一項看起來像密碼，已不予記錄。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ডের মতো দেখতে একটি ক্লিপ রেকর্ড করা হয়নি।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાસવર્ડ જેવી દેખાતી એક ક્લિપ રેકોર્ડ કરવામાં આવી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪಾಸ್‌ವರ್ಡ್‌ನಂತೆ ಕಾಣುತ್ತಿದ್ದ ಒಂದು ಕ್ಲಿಪ್ ಅನ್ನು ದಾಖಲಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാസ്‌വേഡ് പോലെ തോന്നിയ ഒരു ക്ലിപ്പ് രേഖപ്പെടുത്തിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्डसारखी दिसणारी एक क्लिप नोंदवली गेली नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାସୱାର୍ଡ ପରି ଦେଖାଯାଉଥିବା ଗୋଟିଏ କ୍ଲିପ୍ ସଂରକ୍ଷିତ ହୋଇନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਾਸਵਰਡ ਵਰਗੀ ਲੱਗਦੀ ਇੱਕ ਕਲਿੱਪ ਰਿਕਾਰਡ ਨਹੀਂ ਕੀਤੀ ਗਈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnos, ki je bil videti kot geslo, ni bil zabeležen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடவுச்சொல் போலத் தோன்றிய ஒரு கிளிப் பதிவு செய்யப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాస్‌వర్డ్‌లా కనిపించిన ఒక క్లిప్ రికార్డ్ చేయబడలేదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پاس ورڈ جیسا لگنے والا ایک کلپ ریکارڈ نہیں کیا گیا۔"
          }
        }
      }
    },
