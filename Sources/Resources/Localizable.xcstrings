    "Everything is unlocked. A subscription keeps it that way afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء مفتوح الآن. وبعد ذلك يُبقيه الاشتراك كما هو."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot està obert. Després, una subscripció ho manté així."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše je otevřené. Potom to udrží předplatné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er åbent. Bagefter holder et abonnement det sådan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles ist freigeschaltet. Ein Abo hält es danach so."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα είναι ανοιχτά. Έπειτα το κρατά έτσι μια συνδρομή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is unlocked. A subscription keeps it that way afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo está abierto. Una suscripción lo mantiene así después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki on auki. Sen jälkeen tilaus pitää sen niin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est ouvert. Un abonnement le garde ainsi ensuite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול פתוח. אחר כך מינוי שומר על זה ככה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सब कुछ खुला है। उसके बाद सदस्यता इसे ऐसे ही रखती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve je otvoreno. Poslije to održava pretplata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most minden nyitva áll. Utána ezt az előfizetés tartja fenn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya terbuka. Setelah itu langganan yang menjaganya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È tutto aperto. Un abbonamento lo mantiene così anche dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて利用できます。期間後はサブスクリプションで同じ状態が続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기능이 열려 있습니다. 이후에는 구독이 그대로 유지해 줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya terbuka. Selepas itu langganan yang mengekalkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt er åpent. Etterpå holder et abonnement det slik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles staat open. Daarna houdt een abonnement het zo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko jest otwarte. Potem utrzymuje to subskrypcja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tudo liberado. Depois, a assinatura mantém assim."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tudo aberto. Depois, a subscrição mantém assim."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul este deschis. Apoi, abonamentul îl menține așa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас открыто всё. Дальше это сохраняет подписка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko je otvorené. Potom to udrží predplatné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt är öppet. Sedan håller en prenumeration det så."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เปิดใช้ได้ทั้งหมด หลังจากนั้นการสมัครสมาชิกจะรักษาไว้แบบนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey açık. Sonrasında bunu abonelik sürdürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз відкрито все. Далі це зберігає передплата."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện mọi thứ đều mở. Sau đó gói đăng ký giữ nguyên như vậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有功能都已开放。之后由订阅继续保持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有功能都已開放。之後由訂閱繼續保持。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু আনলক করা আছে। পরে একটি সাবস্ক্রিপশন তা এভাবেই রাখবে।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધું અનલૉક છે. ત્યાર પછી સબ્સ્ક્રિપ્શન તેને એમ જ રાખે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲವೂ ಅನ್‌ಲಾಕ್ ಆಗಿದೆ. ನಂತರವೂ ಹಾಗೆಯೇ ಇರಲು ಚಂದಾದಾರಿಕೆ ಬೇಕು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാം അൺലോക്ക് ചെയ്തിരിക്കുന്നു. പിന്നീടും അങ്ങനെ തുടരാൻ ഒരു സബ്സ്ക്രിപ്ഷൻ വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व काही अनलॉक आहे. सदस्यता घेतल्यास नंतरही ते तसेच राहते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସବୁକିଛି ଅନଲକ୍ ଅଛି। ସଦସ୍ୟତା ନେଲେ ପରେ ବି ଏହା ସେହିପରି ରହିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਕੁਝ ਅਨਲੌਕ ਹੈ। ਸਬਸਕ੍ਰਿਪਸ਼ਨ ਨਾਲ ਬਾਅਦ ਵਿੱਚ ਵੀ ਇਹ ਇਸੇ ਤਰ੍ਹਾਂ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse je odklenjeno. Z naročnino bo tako ostalo tudi pozneje."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்தும் திறக்கப்பட்டுள்ளன. அதன் பிறகும் அப்படியே இருக்க ஒரு சந்தா தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్నీ అన్‌లాక్ అయ్యాయి. సబ్‌స్క్రిప్షన్ ఉంటే ఆ తర్వాత కూడా అలాగే ఉంటుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کچھ ان لاک ہے۔ اس کے بعد سبسکرپشن اسے ایسے ہی برقرار رکھتی ہے۔"
          }
        }
      }
    },
