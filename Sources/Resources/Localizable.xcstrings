    "Copies marked secret by 1Password, Bitwarden or Keychain are never recorded.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تضع عليه 1Password أو Bitwarden أو سلسلة المفاتيح علامة السرية لا يُحفظ أبدًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El que l’1Password, el Bitwarden o el Clauer marquen com a secret no es desa mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co 1Password, Bitwarden nebo Klíčenka označí jako tajné, se nikdy neukládá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, som 1Password, Bitwarden eller Nøglering markerer som hemmeligt, bliver aldrig gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was 1Password, Bitwarden oder der Schlüsselbund als geheim markiert, wird nie gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι σημειώνουν ως μυστικό το 1Password, το Bitwarden ή το Μπρελόκ δεν καταγράφεται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies marked secret by 1Password, Bitwarden or Keychain are never recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que 1Password, Bitwarden o Llavero marcan como secreto nunca se guarda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitä, minkä 1Password, Bitwarden tai Avainnippu merkitsee salaiseksi, ei tallenneta koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que 1Password, Bitwarden ou Trousseau marque comme secret n’est jamais enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה ש-1Password, Bitwarden או צרור המפתחות מסמנים כסודי לעולם לא נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden या Keychain जिसे गोपनीय बताते हैं, वह कभी सहेजा नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono što 1Password, Bitwarden ili Svežanj ključeva označe kao tajno nikad se ne sprema."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit az 1Password, a Bitwarden vagy a Kulcskarika titkosnak jelöl, azt soha nem mentjük el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ditandai rahasia oleh 1Password, Bitwarden, atau Keychain tidak pernah disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che 1Password, Bitwarden o Portachiavi segnano come segreto non viene mai registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password、Bitwarden、キーチェーンが秘密として印を付けたものは記録しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden, 키체인이 비밀로 표시한 항목은 기록하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ditanda rahsia oleh 1Password, Bitwarden atau Keychain tidak pernah disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det som 1Password, Bitwarden eller Nøkkelring merker som hemmelig, lagres aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat 1Password, Bitwarden of Sleutelhanger als geheim markeert, wordt nooit bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co 1Password, Bitwarden lub Pęk kluczy oznaczają jako tajne, nigdy nie jest zapisywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que 1Password, Bitwarden ou Chaves marcam como secreto nunca é registrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o 1Password, o Bitwarden ou o Porta-chaves marcam como secreto nunca é guardado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce marchează 1Password, Bitwarden sau Breloc drept secret nu este salvat niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что 1Password, Bitwarden или Связка ключей помечают как секретное, не сохраняется никогда."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To, čo 1Password, Bitwarden alebo Zväzok kľúčov označí ako tajné, sa nikdy neukladá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det som 1Password, Bitwarden eller Nyckelhanteraren märker som hemligt sparas aldrig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ 1Password, Bitwarden หรือพวงกุญแจทำเครื่องหมายว่าเป็นความลับจะไม่ถูกบันทึกเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden veya Anahtar Zinciri’nin gizli işaretlediği şeyler asla kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що 1Password, Bitwarden чи Зв’язка ключів позначають як таємне, не зберігається ніколи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì 1Password, Bitwarden hay Keychain đánh dấu là bí mật sẽ không bao giờ được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password、Bitwarden 或钥匙串标为机密的内容，一律不记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password、Bitwarden 或鑰匙圈標為機密的內容，一律不記錄。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden বা Keychain যেসব কপিকে গোপন হিসেবে চিহ্নিত করে, সেগুলো কখনো রেকর্ড করা হয় না।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden અથવા Keychain જે કૉપિને ગુપ્ત તરીકે ચિહ્નિત કરે છે, તે ક્યારેય રેકોર્ડ થતી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden ಅಥವಾ ಕೀಚೈನ್ ರಹಸ್ಯ ಎಂದು ಗುರುತಿಸಿದ ನಕಲುಗಳನ್ನು ಎಂದಿಗೂ ದಾಖಲಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden അല്ലെങ്കിൽ കീചെയിൻ രഹസ്യമെന്ന് അടയാളപ്പെടുത്തിയ പകർപ്പുകൾ ഒരിക്കലും രേഖപ്പെടുത്തില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden किंवा Keychain ने गुप्त म्हणून चिन्हांकित केलेल्या कॉपी कधीही नोंदवल्या जात नाहीत."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden କିମ୍ବା Keychain ଦ୍ୱାରା ଗୋପନୀୟ ଭାବେ ଚିହ୍ନିତ କପି କେବେ ବି ସଂରକ୍ଷିତ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden ਜਾਂ Keychain ਵੱਲੋਂ ਗੁਪਤ ਮਾਰਕ ਕੀਤੀਆਂ ਕਾਪੀਆਂ ਕਦੇ ਰਿਕਾਰਡ ਨਹੀਂ ਹੁੰਦੀਆਂ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopije, ki jih 1Password, Bitwarden ali Obesek za ključe označijo kot skrivne, se nikoli ne zabeležijo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden அல்லது Keychain ரகசியம் எனக் குறித்த நகல்கள் ஒருபோதும் பதிவு செய்யப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password, Bitwarden లేదా Keychain రహస్యమని గుర్తించిన కాపీలు ఎప్పటికీ రికార్డ్ చేయబడవు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "1Password، Bitwarden یا Keychain کی طرف سے خفیہ نشان زد کاپیاں کبھی ریکارڈ نہیں کی جاتیں۔"
          }
        }
      }
    },
